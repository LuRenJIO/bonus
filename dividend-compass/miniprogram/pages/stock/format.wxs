// format.wxs —— WXML 内联格式化
// 注意：WXS 是受限语法子集 —— 不支持科学计数法（1e8）、isNaN 等全局函数
var ok = function (v) {
  if (v === null || v === undefined) return false;
  if (typeof v !== 'number') return false;
  return v === v; // NaN 是唯一不等于自身的值，借此排除
};

var fmtYi = function (v, d) {
  if (!ok(v)) return '--';
  if (d === undefined) d = 2;
  return (v / 100000000).toFixed(d) + '亿';
};

var fmtNum = function (v, d) {
  if (!ok(v)) return '--';
  if (d === undefined) d = 2;
  return v.toFixed(d);
};

var signed = function (v, d) {
  if (!ok(v)) return '--';
  if (d === undefined) d = 2;
  return (v > 0 ? '+' : '') + v.toFixed(d);
};

var cls = function (v) {
  if (!ok(v) || v === 0) return 'flat';
  return v > 0 ? 'up' : 'down';
};

var pct = function (v) {
  if (!ok(v)) return '--';
  return v + '%';
};

var year = function (dateStr) {
  if (!dateStr) return '--';
  return dateStr.substring(0, 4);
};

// 股息率分位解读：高分位=股息率高=股价相对便宜
var posTag = function (p) {
  if (!ok(p)) return '';
  if (p >= 70) return '股息率高位 · 相对低估';
  if (p <= 30) return '股息率低位 · 相对偏贵';
  return '股息率中性区间';
};
var posClass = function (p) {
  if (!ok(p)) return '';
  if (p >= 70) return 'pos-cheap';
  if (p <= 30) return 'pos-rich';
  return 'pos-mid';
};

module.exports = {
  fmtYi: fmtYi,
  fmtNum: fmtNum,
  signed: signed,
  cls: cls,
  pct: pct,
  year: year,
  posTag: posTag,
  posClass: posClass
};
