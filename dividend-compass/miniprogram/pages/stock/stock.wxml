<!--stock.wxml 股票详情-->
<wxs src="./format.wxs" module="fmt" />

<view class="page">

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-box">
    <view class="loading-text">正在获取 {{name || code}} 的行情与分红数据…</view>
  </view>

  <!-- 错误 -->
  <view wx:elif="{{error}}" class="empty-box">
    <view class="err-main">加载失败</view>
    <view class="err-msg">{{error}}</view>
    <button class="retry-btn" bindtap="onRetry">重试</button>
  </view>

  <!-- 数据主体 -->
  <block wx:elif="{{d}}">

    <!-- ============ 行情头 ============ -->
    <view class="card quote-card">
      <view class="quote-top">
        <view class="quote-left">
          <view class="q-name-row">
            <text class="q-name">{{d.name}}</text>
            <text class="tag tag-blue">{{d.market}}</text>
            <text class="tag">{{d.quote.source === 'tencent' ? '腾讯' : d.quote.source === 'sina' ? '新浪' : '东财'}}</text>
          </view>
          <view class="q-code num">{{d.code}}</view>
        </view>
        <view class="quote-right">
          <view class="q-price num {{fmt.cls(d.quote.change)}}">{{d.quote.price}}</view>
          <view class="q-chg num {{fmt.cls(d.quote.change)}}">
            {{fmt.signed(d.quote.change)}}  {{fmt.signed(d.quote.changePercent)}}%
          </view>
        </view>
      </view>
      <view class="quote-grid">
        <view class="qg-item"><text class="qg-label">今开</text><text class="qg-val num">{{fmt.fmtNum(d.quote.open)}}</text></view>
        <view class="qg-item"><text class="qg-label">昨收</text><text class="qg-val num">{{fmt.fmtNum(d.quote.prevClose)}}</text></view>
        <view class="qg-item"><text class="qg-label">最高</text><text class="qg-val num up">{{fmt.fmtNum(d.quote.high)}}</text></view>
        <view class="qg-item"><text class="qg-label">最低</text><text class="qg-val num down">{{fmt.fmtNum(d.quote.low)}}</text></view>
        <view class="qg-item"><text class="qg-label">换手</text><text class="qg-val num">{{fmt.fmtNum(d.quote.turnoverRate)}}%</text></view>
        <view class="qg-item"><text class="qg-label">PE(TTM)</text><text class="qg-val num">{{fmt.fmtNum(d.quote.peTTM)}}</text></view>
        <view class="qg-item"><text class="qg-label">PB</text><text class="qg-val num">{{fmt.fmtNum(d.quote.pb)}}</text></view>
        <view class="qg-item"><text class="qg-label">总市值</text><text class="qg-val num">{{fmt.fmtYi(d.quote.totalMarketCap, 0)}}</text></view>
      </view>
    </view>

    <!-- ============ 价格走势（分时/日K 可切换，支持滑动查看） ============ -->
    <view class="card">
      <view class="card-title">
        <text>价格走势</text>
        <view class="pred-tabs">
          <view class="pred-tab {{priceMode === 'minute' ? 'active' : ''}}" data-mode="minute" bindtap="onPriceModeTap">分时</view>
          <view class="pred-tab {{priceMode === 'daily' ? 'active' : ''}}" data-mode="daily" bindtap="onPriceModeTap">日K</view>
        </view>
      </view>
      <view wx:if="{{priceLoading}}" class="loading-box" style="padding: 20rpx 0 30rpx;">加载中…</view>
      <block wx:else>
        <view class="price-press-bar" wx:if="{{pricePress}}">
          <text class="pp-time num">{{pricePress.time}}</text>
          <text class="pp-price num">{{pricePress.price}}</text>
          <text class="pp-chg num {{pricePress.chgCls}}">{{pricePress.chgText}}</text>
        </view>
        <view class="cv-wrap">
          <canvas type="2d" id="priceCanvas" class="price-canvas"
                  catchtouchstart="onPriceTouch" catchtouchmove="onPriceTouch"
                  catchtouchend="onPriceTouchEnd" catchtouchcancel="onPriceTouchEnd"></canvas>
        </view>
        <view class="price-note" wx:if="{{pricePress}}">松开手指返回实时视图</view>
        <view class="price-note" wx:elif="{{priceMode === 'minute'}}">按住曲线滑动查看每分钟数据 · 金虚线为昨收</view>
        <view class="price-note" wx:else>按住曲线滑动查看历史点位 · 近1年不复权收盘价</view>
      </block>
    </view>

    <!-- ============ 黄金ETF 专属说明（ETF 详情页替换红利卡组） ============ -->
    <view class="card card-accent" wx:if="{{isEtf}}">
      <view class="card-title"><text>关于黄金ETF</text><text class="sub">跟踪金价 · 配置工具</text></view>
      <view class="etf-edu">
        <view class="etf-row">· 紧密跟踪国内金价（上海金 Au99.99），场内价格与金价偏离极小</view>
        <view class="etf-row">· 支持 <text class="gold-text">T+0 回转交易</text>，当天买卖灵活；交易免印花税</view>
        <view class="etf-row">· 黄金不派息——<text class="gold-text">没有股息与分红</text>，收益完全来自金价波动</view>
        <view class="etf-row">· 常见做法：作为组合 5%~10% 的对冲配置，而非博取短期价差</view>
      </view>
    </view>

    <!-- ============ 股息率核心卡（ETF 无股息，隐藏） ============ -->
    <view class="card yield-card" wx:if="{{!isEtf}}">
      <view class="card-title">
        <text>股息率（TTM口径）</text>
        <view class="yt-right">
          <text class="sub">近12个月已实施分红 ÷ 现价</text>
          <text class="bell {{alertOn ? 'on' : ''}}" catchtap="onBellTap">{{alertOn ? '🔔 ≥' + alertThreshold + '%' : '🔔 提醒'}}</text>
        </view>
      </view>
      <view class="yield-main">
        <view class="yield-left">
          <view class="yield-big num t-hero gold-glow">{{d.dividend.ttm.yield === null ? '--' : d.dividend.ttm.yield + '%'}}</view>
          <view class="yield-sub">TTM每股分红 {{fmt.fmtNum(d.dividend.ttm.perShare, 4)}} 元</view>
        </view>
        <view class="yield-right" wx:if="{{d.dividend.annual.length}}">
          <view class="yr-item">
            <text class="yr-label">{{d.dividend.annual[0].year}}年度</text>
            <text class="yr-val num">{{d.dividend.annual[0].yieldNow === null ? '--' : d.dividend.annual[0].yieldNow + '%'}}</text>
          </view>
        </view>
      </view>

      <!-- TTM 分红明细（按报告期） -->
      <view wx:if="{{d.dividend.ttm.detail.length}}" class="ttm-detail">
        <view class="ttm-row" wx:for="{{d.dividend.ttm.detail}}" wx:key="exDate">
          <text class="ttm-date num">{{item.exDate}} 除息</text>
          <text class="ttm-plan">{{item.profile}}</text>
        </view>
      </view>

      <!-- 待实施分红 -->
      <view wx:if="{{d.dividend.pending.length}}" class="pending-box">
        <view class="pending-title">已公告待实施</view>
        <view class="pending-row" wx:for="{{d.dividend.pending}}" wx:key="planNoticeDate">
          <text class="pending-plan">{{item.profile || '分红方案'}}</text>
          <text class="pending-status">{{item.progress}}</text>
        </view>
      </view>

      <view wx:if="{{!d.dividend.ttm.detail.length && !d.dividend.pending.length}}" class="no-div-tip">
        近12个月无已实施现金分红
      </view>
    </view>

    <!-- ============ 预测卡 ============ -->
    <view class="card pred-card" wx:if="{{!isEtf && d.prediction.hasEnoughData}}">
      <view class="card-title">
        <text>{{d.prediction.nextPeriod}}预期分红</text>
        <view class="pred-tabs">
          <view class="pred-tab {{predMode === 'basic' ? 'active' : ''}}" data-mode="basic" bindtap="onSwitchPredMode">多模型区间</view>
          <view class="pred-tab {{predMode === 'enhanced' ? 'active' : ''}}" data-mode="enhanced" bindtap="onSwitchPredMode">盈利修正</view>
        </view>
      </view>

      <!-- 三档区间 -->
      <block wx:if="{{predMode === 'basic'}}">
        <view class="range-row">
          <view class="range-col">
            <view class="rc-label">保守</view>
            <view class="rc-div num">{{fmt.fmtNum(d.prediction.basic.range.conservative, 3)}}元</view>
            <view class="rc-yield num">{{d.prediction.basic.yields.conservative}}%</view>
          </view>
          <view class="range-col main-col">
            <view class="rc-label">中性</view>
            <view class="rc-div num gold-text">{{fmt.fmtNum(d.prediction.basic.range.neutral, 3)}}元</view>
            <view class="rc-yield num gold-text">{{d.prediction.basic.yields.neutral}}%</view>
          </view>
          <view class="range-col">
            <view class="rc-label">乐观</view>
            <view class="rc-div num">{{fmt.fmtNum(d.prediction.basic.range.optimistic, 3)}}元</view>
            <view class="rc-yield num">{{d.prediction.basic.yields.optimistic}}%</view>
          </view>
        </view>

        <!-- 模型明细 -->
        <view class="model-box">
          <view class="model-row">
            <text class="model-name">模型A 分红趋势</text>
            <text class="model-val num">{{fmt.fmtNum(d.prediction.basic.modelA.value, 3)}}元</text>
          </view>
          <view class="model-note">近几个分红年度CAGR {{fmt.signed(d.prediction.basic.modelA.divGrowth, 1)}}%（限幅后 {{fmt.signed(d.prediction.basic.modelA.clampedGrowth, 1)}}%），{{d.prediction.basic.modelA.desc}}</view>
          <view class="model-row" wx:if="{{d.prediction.basic.modelB}}">
            <text class="model-name">模型B 派息率×净利</text>
            <text class="model-val num">{{fmt.fmtNum(d.prediction.basic.modelB.value, 3)}}元</text>
          </view>
          <view class="model-note" wx:if="{{d.prediction.basic.modelB}}">近3年均值派息率 {{fmt.fmtNum(d.prediction.basic.modelB.payoutRatio, 1)}}% × 预测净利润（增速 {{fmt.signed(d.prediction.basic.modelB.profitGrowth, 1)}}%）</view>
          <view class="model-row" wx:if="{{d.prediction.basic.modelC}}">
            <text class="model-name">模型C 机构预期</text>
            <text class="model-val num">{{fmt.fmtNum(d.prediction.basic.modelC.value, 3)}}元</text>
          </view>
          <view class="model-note" wx:if="{{d.prediction.basic.modelC}}">近1年 {{d.prediction.basic.modelC.orgCount}} 篇研报一致预期EPS {{fmt.fmtNum(d.prediction.basic.modelC.eps, 2)}}元 × 均值派息率 {{fmt.fmtNum(d.prediction.basic.modelC.payoutRatio, 1)}}%</view>
        </view>
      </block>

      <block wx:else>
        <view class="range-row">
          <view class="range-col">
            <view class="rc-label">保守</view>
            <view class="rc-div num">{{fmt.fmtNum(d.prediction.enhanced.range.conservative, 3)}}元</view>
            <view class="rc-yield num">{{d.prediction.enhanced.yields.conservative}}%</view>
          </view>
          <view class="range-col main-col">
            <view class="rc-label">中性</view>
            <view class="rc-div num gold-text">{{fmt.fmtNum(d.prediction.enhanced.range.neutral, 3)}}元</view>
            <view class="rc-yield num gold-text">{{d.prediction.enhanced.yields.neutral}}%</view>
          </view>
          <view class="range-col">
            <view class="rc-label">乐观</view>
            <view class="rc-div num">{{fmt.fmtNum(d.prediction.enhanced.range.optimistic, 3)}}元</view>
            <view class="rc-yield num">{{d.prediction.enhanced.yields.optimistic}}%</view>
          </view>
        </view>

        <!-- 信心度 + 因子 -->
        <view class="conf-row">
          <text class="conf-label">预测信心度</text>
          <view class="conf-bar">
            <view class="conf-fill" style="width: {{d.prediction.enhanced.confidence}}%"></view>
          </view>
          <text class="conf-val num">{{d.prediction.enhanced.confidence}}/100</text>
        </view>
        <view class="factor-list">
          <view class="factor-item" wx:for="{{d.prediction.enhanced.factors}}" wx:key="name">
            <view class="fi-head">
              <text class="fi-name">{{item.name}}</text>
              <text class="fi-effect {{item.effect === '+' ? 'up' : item.effect === '-' ? 'down' : 'flat'}}">{{item.effect === '+' ? '上调' : item.effect === '-' ? '下调' : '持平'}}</text>
            </view>
            <view class="fi-value num">{{item.value}}</view>
            <view class="fi-note">{{item.detail}}</view>
          </view>
        </view>
      </block>

      <view class="pred-note">预测基于公开历史数据推算，仅供参考，实际分红以公司公告为准</view>
    </view>

    <!-- 无预测数据 -->
    <view class="card" wx:elif="{{!isEtf}}">
      <view class="card-title"><text>预期分红</text></view>
      <view class="no-div-tip">
        <block wx:if="{{d.prediction.notes.length}}">{{d.prediction.notes[0]}}</block>
        <block wx:else>历史分红数据不足，暂无法预测</block>
      </view>
    </view>

    <!-- ============ 股息率阶梯 · 买入参考价 ============ -->
    <view class="card" wx:if="{{!isEtf && d.quote.price}}">
      <view class="card-title">
        <text>股息率阶梯 · 买入参考价</text>
        <text class="sub">对应股价 = 分红 ÷ 股息率</text>
      </view>

      <!-- 分红基准（默认预期分红，可修改） -->
      <view class="ld-input-row">
        <text class="ld-in-label">分红基准</text>
        <view class="ld-in-box">
          <input class="ld-in" type="digit" value="{{ladderInput}}" bindinput="onLadderInput" placeholder="输入每股分红" placeholder-class="ld-ph" />
          <text class="ld-in-unit">元/股</text>
        </view>
        <view class="ld-reset" wx:if="{{ladderDefault}}" bindtap="onLadderReset">恢复预期</view>
      </view>

      <!-- 阶梯表格 -->
      <block wx:if="{{ladder && ladder.rows.length}}">
        <view class="ld-head">
          <text class="ldh-y">股息率</text>
          <text class="ldh-p">对应股价</text>
          <text class="ldh-d">较现价</text>
        </view>
        <view class="ld-row {{index === ladder.closestIndex ? 'hit' : ''}}" wx:for="{{ladder.rows}}" wx:key="yield">
          <text class="ld-y num">{{item.yield}}%<text wx:if="{{index === ladder.closestIndex}}" class="ld-hit-tag">现价</text></text>
          <text class="ld-p num">{{item.price}}元</text>
          <text class="ld-d num">{{item.diff}}%</text>
        </view>
        <view class="ladder-tip">现价 {{d.quote.price}} 元 ≈ {{ladder.rows[ladder.closestIndex].yield}} 档 · 股价越低股息率越高 · 税前口径</view>
      </block>
      <view wx:else class="no-div-tip">输入每股分红后自动计算 3%~9% 各档对应股价</view>
    </view>

    <!-- ============ 股息率曲线 ============ -->
    <view class="card" wx:if="{{!isEtf && d.yieldCurve && d.yieldCurve.points.length >= 2}}">
      <view class="card-title">
        <text>股息率曲线</text>
        <text class="sub">月末TTM股息率 · 近5年</text>
      </view>
      <view class="yc-wrap">
        <canvas type="2d" id="yieldCanvas" class="yc-canvas"></canvas>
      </view>
      <view class="yc-legend">
        <view class="yl-item"><text class="yl-dot" style="background:#d4a94e"></text>历史TTM股息率</view>
        <view class="yl-item"><text class="yl-dot" style="background:transparent;border:2rpx solid #e57373"></text>预期股息率（中性）</view>
      </view>
      <view class="yc-pos" wx:if="{{d.yieldCurve.percentile !== null && d.yieldCurve.percentile !== undefined}}">
        <text>当前股息率处于近5年 </text>
        <text class="yc-pos-num num {{fmt.posClass(d.yieldCurve.percentile)}}">{{d.yieldCurve.percentile}}%</text>
        <text> 分位</text>
        <text class="yc-pos-tag {{fmt.posClass(d.yieldCurve.percentile)}}">{{fmt.posTag(d.yieldCurve.percentile)}}</text>
      </view>
    </view>

    <!-- ============ 行业股息率对比 ============ -->
    <view class="card" wx:if="{{!isEtf && d.industryRank}}">
      <view class="card-title">
        <text>行业股息率对比</text>
        <text class="sub">{{d.industryRank.board}}</text>
      </view>
      <view class="ir-main">
        <view class="ir-rank num">第 {{d.industryRank.rank}}<text class="ir-total">/{{d.industryRank.total}}</text></view>
        <view class="ir-sub">同行业中股息率排名 · 我的 {{d.industryRank.myYield}}%</view>
      </view>
      <view class="ir-top">
        <text class="ir-top-label">行业前三</text>
        <view class="ir-top-row" wx:for="{{d.industryRank.top}}" wx:key="code"
              data-code="{{item.code}}" data-name="{{item.name}}" bindtap="goPeer">
          <text class="ir-top-name">{{index + 1}}. {{item.name}}</text>
          <text class="ir-top-yld num gold-text">{{item.ttmYield}}%</text>
        </view>
      </view>
      <view class="price-note">排名基于全市场同行业 TTM 股息率（每日更新）</view>
    </view>

    <!-- ============ 波动与风险 ============ -->
    <view class="card" wx:if="{{d.risk}}">
      <view class="card-title">
        <text>波动与风险</text>
        <text class="sub">低波策略视角 · 月度口径</text>
      </view>
      <view class="risk-grid">
        <view class="risk-item">
          <text class="risk-val num">{{fmt.fmtNum(d.risk.volatility, 1)}}%</text>
          <text class="risk-label">年化波动率</text>
          <text class="risk-sub">近1年·月度收益</text>
        </view>
        <view class="risk-item">
          <text class="risk-val num">{{fmt.fmtNum(d.risk.maxDrawdown, 1)}}%</text>
          <text class="risk-label">最大回撤</text>
          <text class="risk-sub">近1年·月末价</text>
        </view>
        <view class="risk-item">
          <text class="risk-val num">{{fmt.fmtNum(d.risk.beta, 2)}}</text>
          <text class="risk-label">Beta</text>
          <text class="risk-sub">近5年·对沪深300</text>
        </view>
      </view>
    </view>

    <!-- ============ 分红涨薪史 ============ -->
    <view class="card" wx:if="{{!isEtf && growth}}">
      <view class="card-title">
        <text>分红涨薪史</text>
        <text class="growth-badge" wx:if="{{growth.badge}}">{{growth.badge}}</text>
      </view>
      <view class="gh-chart">
        <view class="gh-col" wx:for="{{growth.years}}" wx:key="year">
          <text class="gh-val num">{{item.valText}}</text>
          <view class="gh-bar {{item.hot ? 'hot' : ''}}" style="height: {{item.h}}rpx"></view>
          <text class="gh-yoy {{item.yoyCls}}">{{item.yoyText}}</text>
          <text class="gh-yr num">{{item.year}}</text>
        </view>
      </view>
      <view class="price-note">每股分红（元/股，按报告期归属年）· 连续增长≥5年认证"股息贵族" · 大额特别分红可能影响连续性判断</view>
    </view>

    <!-- ============ 分红历史 ============ -->
    <view class="card" wx:if="{{!isEtf && d.dividend.annual.length}}">
      <view class="card-title">
        <text>历年分红</text>
        <text class="sub link-gold" bindtap="goReinvest">再投模拟 ›</text>
      </view>
      <view class="table-row table-head">
        <text class="c-year">年度</text>
        <text class="c-div">每股分红</text>
        <text class="c-times">次数</text>
        <text class="c-pr">派息率</text>
        <text class="c-yield">现价股息率</text>
      </view>
      <view class="table-row" wx:for="{{d.dividend.annual}}" wx:key="year">
        <text class="c-year num">{{item.year}}</text>
        <text class="c-div num">{{fmt.fmtNum(item.perShare, 4)}}</text>
        <text class="c-times num">{{item.times}}</text>
        <text class="c-pr num {{item.payoutRatio > 100 ? 'up' : ''}}">{{item.payoutRatio === null ? '--' : fmt.fmtNum(item.payoutRatio, 1) + '%'}}</text>
        <text class="c-yield num">{{item.yieldNow === null ? '--' : item.yieldNow + '%'}}</text>
      </view>
    </view>

    <!-- ============ 财务表现 ============ -->
    <view class="card" wx:if="{{!isEtf && d.finance.latest}}">
      <view class="card-title">
        <text>财务表现</text>
        <text class="sub">来源：定期报告（东财F10）</text>
      </view>

      <!-- 最新报告期 -->
      <view class="latest-report">
        <view class="lr-title">{{d.finance.latest.reportType || d.finance.latest.reportDate}}</view>
        <view class="lr-grid">
          <view class="lrg-item">
            <text class="lrg-label">营收</text>
            <view class="lrg-vals">
              <text class="lrg-val num">{{fmt.fmtYi(d.finance.latest.revenue, 1)}}</text>
              <text wx:if="{{d.finance.latest.revenueYoy !== null}}" class="lrg-chg num {{fmt.cls(d.finance.latest.revenueYoy)}}">{{fmt.signed(d.finance.latest.revenueYoy, 1)}}%</text>
            </view>
          </view>
          <view class="lrg-item">
            <text class="lrg-label">归母净利</text>
            <view class="lrg-vals">
              <text class="lrg-val num">{{fmt.fmtYi(d.finance.latest.parentNetProfit, 1)}}</text>
              <text wx:if="{{d.finance.latest.netProfitYoy !== null}}" class="lrg-chg num {{fmt.cls(d.finance.latest.netProfitYoy)}}">{{fmt.signed(d.finance.latest.netProfitYoy, 1)}}%</text>
            </view>
          </view>
          <view class="lrg-item">
            <text class="lrg-label">ROE</text>
            <view class="lrg-vals">
              <text class="lrg-val num">{{fmt.fmtNum(d.finance.latest.roeWeighted, 2)}}%</text>
            </view>
            <text class="lrg-sub">加权</text>
          </view>
          <view class="lrg-item">
            <text class="lrg-label">每股未分配</text>
            <view class="lrg-vals">
              <text class="lrg-val num">{{fmt.fmtNum(d.finance.latest.perUnassignProfit, 2)}}元</text>
            </view>
            <text class="lrg-sub">利润</text>
          </view>
        </view>
      </view>

      <!-- 年度财务：每年一档，营收/归母净利纵向堆叠 + 增速徽章 + ROE 独立右栏 -->
      <view class="fin-list">
        <view class="fin-year-row" wx:for="{{d.finance.annual}}" wx:key="reportDate">
          <view class="fy-year-col">
            <text class="fy-year num">{{fmt.year(item.reportDate)}}</text>
            <text class="fy-year-sub">年报</text>
          </view>
          <view class="fy-metrics">
            <view class="fm-line">
              <text class="fm-label">营收</text>
              <text class="fm-val num">{{fmt.fmtYi(item.revenue, 0)}}</text>
              <text wx:if="{{item.revenueYoy !== null}}" class="fm-chip num {{fmt.cls(item.revenueYoy)}}">{{fmt.signed(item.revenueYoy, 1)}}%</text>
            </view>
            <view class="fm-line">
              <text class="fm-label">归母净利</text>
              <text class="fm-val num">{{fmt.fmtYi(item.parentNetProfit, 0)}}</text>
              <text wx:if="{{item.netProfitYoy !== null}}" class="fm-chip num {{fmt.cls(item.netProfitYoy)}}">{{fmt.signed(item.netProfitYoy, 1)}}%</text>
            </view>
          </view>
          <view class="fy-roe">
            <text class="fy-roe-val num">{{fmt.fmtNum(item.roeWeighted, 1)}}%</text>
            <text class="fy-roe-label">ROE</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ============ 分红可持续性体检 ============ -->
    <view class="card card-accent health-card" wx:if="{{!isEtf && d.health}}">
      <view class="card-title">
        <text>分红可持续性体检</text>
        <text class="sub">6维度评估</text>
      </view>
      <view class="health-head">
        <view class="hh-score num {{d.health.grade === 'A' ? 'grade-a' : d.health.grade === 'B' ? 'grade-b' : d.health.grade === 'C' ? 'grade-c' : 'grade-d'}}">{{d.health.score}}</view>
        <view class="hh-info">
          <view class="hh-grade">{{d.health.grade}} · {{d.health.label}}</view>
          <view class="hh-note">综合评分越高，当前分红水平的可持续性越强</view>
        </view>
      </view>
      <view class="health-items">
        <view class="health-item" wx:for="{{d.health.items}}" wx:key="name">
          <view class="hi-top">
            <view class="dot dot-{{item.status}}"></view>
            <text class="hi-name">{{item.name}}</text>
            <text class="hi-value num">{{item.value}}</text>
          </view>
          <view class="hi-note">{{item.note}}</view>
        </view>
      </view>
    </view>

    <!-- 页脚 -->
    <view class="footer-tip">
      <view wx:if="{{!isEtf}}">数据来源：东方财富 · 腾讯财经｜分红为税前口径</view>
      <view wx:else>数据来源：东方财富 · 腾讯财经｜黄金ETF行情与金价数据</view>
      <view>本工具仅供研究参考，不构成投资建议</view>
    </view>

    <!-- 底部占位（避免被操作栏遮挡） -->
    <view class="bottom-holder"></view>
  </block>
</view>

<!-- 底部操作栏 -->
<view class="action-bar" wx:if="{{d && !loading && !error}}">
  <view class="ab-fav {{isFav ? 'is-fav' : ''}}" bindtap="onToggleFav">
    <text>{{isFav ? '★ 已自选' : '☆ 加入自选'}}</text>
  </view>
  <view class="ab-refresh" bindtap="onRetry">
    <text>↻ 刷新</text>
  </view>
</view>
