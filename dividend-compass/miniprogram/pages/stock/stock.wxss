/* stock.wxss —— 股票详情页 */

.page {
  padding-bottom: 140rpx;
  min-height: 100vh;
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-sub);
}
.loading-sub {
  font-size: 22rpx;
  color: var(--text-dim);
  margin-top: 12rpx;
}

.err-main { font-size: 32rpx; color: var(--text); }
.err-msg { font-size: 24rpx; color: var(--text-sub); margin-top: 12rpx; }
.retry-btn {
  margin-top: 30rpx;
  background: var(--gold-bg);
  color: var(--gold);
  font-size: 26rpx;
  padding: 0 50rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
}

/* ================= 行情头 ================= */
.quote-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.q-name-row { display: flex; align-items: center; }
.q-name { font-size: 36rpx; font-weight: 600; }
.q-code { font-size: 24rpx; color: var(--text-dim); margin-top: 6rpx; letter-spacing: 2rpx; }

.quote-right { text-align: right; }
.q-price { font-size: 52rpx; font-weight: 700; line-height: 1.1; }
.q-chg { font-size: 26rpx; margin-top: 4rpx; }

.quote-grid {
  display: flex;
  flex-wrap: wrap;
  border-top: 1rpx solid var(--border);
  padding-top: 20rpx;
}

.qg-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  padding: 10rpx 0;
}
.qg-label { font-size: 20rpx; color: var(--text-dim); }
.qg-val { font-size: 26rpx; margin-top: 6rpx; }

/* ================= 股息率卡 ================= */
.yield-card {
  border: 1rpx solid rgba(212, 169, 78, 0.35);
  background: linear-gradient(160deg, rgba(212, 169, 78, 0.08), var(--card) 55%);
}

.yield-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.yield-big {
  font-size: 64rpx;
  font-weight: 700;
  color: var(--gold);
  line-height: 1.1;
}

.yield-sub {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 8rpx;
}

.yield-right { text-align: right; }
.yr-item { display: flex; flex-direction: column; align-items: flex-end; }
.yr-label { font-size: 20rpx; color: var(--text-dim); }
.yr-val { font-size: 32rpx; font-weight: 600; color: var(--gold); margin-top: 4rpx; }

.ttm-detail {
  margin-top: 24rpx;
  border-top: 1rpx dashed var(--border);
  padding-top: 16rpx;
}
.ttm-row {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  padding: 8rpx 0;
  color: var(--text-sub);
}
.ttm-date { color: var(--gold); }

.pending-box {
  margin-top: 20rpx;
  background: var(--gold-bg);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}
.pending-title { font-size: 22rpx; color: var(--gold); font-weight: 600; }
.pending-row {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 8rpx;
}
.pending-status { color: var(--gold); }

.no-div-tip {
  font-size: 24rpx;
  color: var(--text-dim);
  text-align: center;
  padding: 30rpx 0;
}

/* ================= 预测卡 ================= */
.pred-tabs {
  display: flex;
  background: var(--bg);
  border-radius: 10rpx;
  padding: 4rpx;
}
.pred-tab {
  font-size: 22rpx;
  color: var(--text-sub);
  padding: 8rpx 18rpx;
  border-radius: 8rpx;
}
.pred-tab.active {
  background: var(--gold-bg);
  color: var(--gold);
  font-weight: 600;
}

.range-row {
  display: flex;
  text-align: center;
  padding: 24rpx 0 8rpx;
}
.range-col { flex: 1; }
.main-col {
  flex: 1.2;
  border-left: 1rpx solid var(--border);
  border-right: 1rpx solid var(--border);
}
.rc-label { font-size: 22rpx; color: var(--text-dim); }
.rc-div { font-size: 32rpx; font-weight: 600; margin-top: 10rpx; }
.rc-yield { font-size: 24rpx; color: var(--text-sub); margin-top: 6rpx; }
.gold-text { color: var(--gold); }

.model-box {
  border-top: 1rpx solid var(--border);
  padding-top: 20rpx;
  margin-top: 16rpx;
}
.model-row {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
}
.model-name { color: var(--text-sub); }
.model-val { font-weight: 600; }
.model-note {
  font-size: 20rpx;
  color: var(--text-dim);
  margin: 8rpx 0 16rpx;
  line-height: 1.6;
}

.conf-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}
.conf-label { font-size: 22rpx; color: var(--text-sub); flex-shrink: 0; }
.conf-bar {
  flex: 1;
  height: 14rpx;
  background: var(--bg);
  border-radius: 8rpx;
  margin: 0 16rpx;
  overflow: hidden;
}
.conf-fill {
  height: 100%;
  background: linear-gradient(90deg, #8a6d2f, var(--gold));
  border-radius: 8rpx;
}
.conf-val { font-size: 24rpx; color: var(--gold); flex-shrink: 0; }

.factor-list { margin-top: 8rpx; }
.factor-item {
  background: var(--bg);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 14rpx;
}
.fi-head { display: flex; justify-content: space-between; }
.fi-name { font-size: 24rpx; font-weight: 500; }
.fi-effect { font-size: 22rpx; }
.fi-value { font-size: 22rpx; color: var(--text-sub); margin-top: 6rpx; }
.fi-note { font-size: 20rpx; color: var(--text-dim); margin-top: 6rpx; line-height: 1.5; }

.pred-note {
  font-size: 20rpx;
  color: var(--text-dim);
  text-align: center;
  padding-top: 16rpx;
}

/* ================= 分红历史表 ================= */
.c-year { width: 110rpx; }
.c-div { width: 140rpx; }
.c-times { width: 80rpx; text-align: center; }
.c-pr { width: 120rpx; text-align: right; }
.c-yield { flex: 1; text-align: right; }

/* ================= 股息率阶梯 ================= */
.ld-input-row {
  display: flex;
  align-items: center;
  background: var(--bg);
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  margin-bottom: 20rpx;
}
.ld-in-label { font-size: 22rpx; color: var(--text-dim); margin-right: 20rpx; }
.ld-in-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: rgba(212, 169, 78, 0.07);
  border: 1rpx solid rgba(212, 169, 78, 0.3);
  border-radius: 10rpx;
  padding: 10rpx 16rpx;
}
.ld-in { flex: 1; font-size: 28rpx; font-weight: 600; color: #e8b95f; height: 40rpx; line-height: 40rpx; }
.ld-ph { color: rgba(139, 148, 158, 0.6); font-weight: 400; }
.ld-in-unit { font-size: 22rpx; color: var(--text-dim); margin-left: 8rpx; }
.ld-reset {
  font-size: 22rpx;
  color: #e8b95f;
  margin-left: 20rpx;
  padding: 6rpx 0 6rpx 20rpx;
  border-left: 1rpx solid rgba(148, 163, 184, 0.25);
}
.ld-head { display: flex; align-items: center; padding: 4rpx 12rpx 10rpx; }
.ldh-y { flex: 1; font-size: 20rpx; color: var(--text-dim); }
.ldh-p { flex: 1.3; font-size: 20rpx; color: var(--text-dim); text-align: right; }
.ldh-d { flex: 0.9; font-size: 20rpx; color: var(--text-dim); text-align: right; }
.ld-row {
  display: flex;
  align-items: center;
  padding: 11rpx 12rpx;
  border-radius: 10rpx;
}
.ld-row:nth-child(odd) { background: rgba(148, 163, 184, 0.05); }
.ld-row.hit {
  background: rgba(212, 169, 78, 0.14);
  box-shadow: inset 3rpx 0 0 #d4a94e;
}
.ld-y { flex: 1; font-size: 26rpx; font-weight: 700; color: var(--gold); }
.ld-hit-tag {
  display: inline-block;
  vertical-align: 4rpx;
  margin-left: 10rpx;
  padding: 0 10rpx;
  height: 30rpx;
  line-height: 30rpx;
  font-size: 18rpx;
  font-weight: 600;
  color: #1a1d24;
  background: #d4a94e;
  border-radius: 8rpx;
}
.ld-p { flex: 1.3; font-size: 26rpx; font-weight: 600; text-align: right; }
.ld-d { flex: 0.9; font-size: 22rpx; color: var(--text-dim); text-align: right; }
.ladder-tip {
  margin-top: 16rpx;
  font-size: 20rpx;
  color: var(--text-dim);
  line-height: 1.5;
}

/* ================= 股息率曲线 ================= */
.yc-wrap { width: 100%; }
.yc-canvas { width: 100%; height: 400rpx; }
.yc-legend { display: flex; }
.yl-item { display: flex; align-items: center; font-size: 20rpx; color: var(--text-dim); margin-right: 28rpx; }
.yl-dot { width: 18rpx; height: 18rpx; border-radius: 50%; margin-right: 8rpx; }
.yc-pos {
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  background: var(--bg);
  border-radius: 10rpx;
  font-size: 22rpx;
  color: var(--text-dim);
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}
.yc-pos-num { font-size: 28rpx; font-weight: 700; margin: 0 4rpx; }
.yc-pos-num.pos-cheap { color: #e8b95f; }
.yc-pos-num.pos-rich { color: #6fbf8f; }
.yc-pos-num.pos-mid { color: var(--text-main); }
.yc-pos-tag {
  margin-left: auto;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}
.yc-pos-tag.pos-cheap { color: #e8b95f; background: rgba(212, 169, 78, 0.14); }
.yc-pos-tag.pos-rich { color: #6fbf8f; background: rgba(111, 191, 143, 0.12); }
.yc-pos-tag.pos-mid { color: var(--text-dim); background: rgba(148, 163, 184, 0.12); }

/* ================= 股息率提醒铃铛 ================= */
.yt-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.bell {
  font-size: 22rpx;
  color: var(--text-dim);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: rgba(148, 163, 184, 0.12);
}
.bell.on {
  color: #e8b95f;
  background: rgba(212, 169, 78, 0.16);
  font-weight: 600;
}

/* ================= 价格走势 ================= */
.price-canvas { width: 100%; height: 300rpx; }
.price-press-bar {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
  padding: 4rpx 4rpx 8rpx;
  min-height: 48rpx;
}
.pp-time { font-size: 24rpx; color: var(--text-sub); }
.pp-price { font-size: 30rpx; font-weight: 700; }
.pp-chg { font-size: 24rpx; font-weight: 600; }
.price-note {
  font-size: 20rpx;
  color: var(--text-dim);
  margin-top: 10rpx;
  line-height: 1.6;
}

/* ================= 行业股息率对比 ================= */
.ir-main { display: flex; align-items: baseline; gap: 16rpx; padding: 6rpx 0 14rpx; }
.ir-rank { font-size: 44rpx; font-weight: 700; color: var(--gold); }
.ir-total { font-size: 22rpx; font-weight: 400; color: var(--text-dim); margin-left: 4rpx; }
.ir-sub { font-size: 22rpx; color: var(--text-sub); }
.ir-top { border-top: 1rpx solid var(--border); padding-top: 12rpx; }
.ir-top-label { font-size: 20rpx; color: var(--text-dim); }
.ir-top-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0 0;
  font-size: 24rpx;
}
.ir-top-name { color: var(--text-main); }
.ir-top-yld { font-weight: 600; }

/* ================= 分红涨薪史 ================= */
.growth-badge {
  font-size: 20rpx;
  color: #e8b95f;
  background: rgba(212, 169, 78, 0.14);
  border-radius: var(--radius-full, 999rpx);
  padding: 4rpx 16rpx;
  font-weight: 600;
}
.gh-chart {
  display: flex;
  align-items: flex-end;
  gap: 6rpx;
  padding: 8rpx 0 0;
}
.gh-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}
.gh-val { font-size: 19rpx; color: var(--text-sub); margin-bottom: 6rpx; }
.gh-bar {
  width: 64%;
  background: linear-gradient(180deg, rgba(212, 169, 78, 0.75), rgba(212, 169, 78, 0.3));
  border-radius: 6rpx 6rpx 0 0;
}
.gh-bar.hot {
  background: linear-gradient(180deg, #e8b95f, rgba(212, 169, 78, 0.45));
}
.gh-yoy { font-size: 18rpx; margin-top: 6rpx; }
.gh-yoy.up { color: #f04b5a; }
.gh-yoy.dn { color: #00b578; }
.gh-yr { font-size: 18rpx; color: var(--text-dim); margin-top: 4rpx; }

/* ================= 波动与风险 ================= */
.risk-grid { display: flex; }
.risk-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0;
}
.risk-item + .risk-item { border-left: 1rpx solid rgba(148, 163, 184, 0.12); }
.risk-val { font-size: 34rpx; font-weight: 700; color: var(--gold); }
.risk-label { font-size: 22rpx; color: var(--text-main); margin-top: 8rpx; }
.risk-sub { font-size: 18rpx; color: var(--text-dim); margin-top: 4rpx; }

/* ================= 财务 ================= */
.latest-report {
  background: var(--bg);
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 8rpx;
}
.lr-title { font-size: 24rpx; color: var(--gold); font-weight: 600; margin-bottom: 16rpx; }
.lr-grid { display: flex; }
.lrg-item { flex: 1; display: flex; flex-direction: column; }
.lrg-label { font-size: 20rpx; color: var(--text-dim); }
.lrg-vals { display: flex; align-items: baseline; margin-top: 8rpx; }
.lrg-val { font-size: 26rpx; font-weight: 600; white-space: nowrap; }
.lrg-chg { font-size: 20rpx; margin-left: 10rpx; white-space: nowrap; }
.lrg-sub { font-size: 20rpx; margin-top: 4rpx; color: var(--text-dim); }

/* 年度财务：每年一行，年份居左、指标两行堆叠、增速徽章、ROE 右栏 */
.fin-year-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.fin-year-row:last-child { border-bottom: none; }
.fy-year-col { width: 100rpx; display: flex; flex-direction: column; flex-shrink: 0; }
.fy-year { font-size: 32rpx; font-weight: 700; color: var(--gold); line-height: 1.2; }
.fy-year-sub { font-size: 18rpx; color: var(--text-dim); margin-top: 2rpx; }
.fy-metrics { flex: 1; display: flex; flex-direction: column; }
.fm-line { display: flex; align-items: center; }
.fm-line + .fm-line { margin-top: 10rpx; }
.fm-label { width: 112rpx; font-size: 20rpx; color: var(--text-dim); flex-shrink: 0; }
.fm-val { font-size: 26rpx; font-weight: 600; margin-right: 12rpx; white-space: nowrap; }
.fm-chip {
  font-size: 20rpx;
  line-height: 1.5;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  white-space: nowrap;
}
.fm-chip.up { color: var(--up); background: var(--up-bg); }
.fm-chip.down { color: var(--down); background: var(--down-bg); }
.fm-chip.flat { color: var(--text-sub); background: var(--card-hover); }
.fy-roe { width: 110rpx; display: flex; flex-direction: column; align-items: flex-end; flex-shrink: 0; }
.fy-roe-val { font-size: 26rpx; font-weight: 600; }
.fy-roe-label { font-size: 18rpx; color: var(--text-dim); margin-top: 2rpx; }

/* ================= 体检 ================= */
.health-head {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.hh-score {
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1;
  margin-right: 28rpx;
}
.grade-a { color: #00b578; }
.grade-b { color: var(--gold); }
.grade-c { color: #e0a23c; }
.grade-d { color: var(--up); }
.hh-grade { font-size: 30rpx; font-weight: 600; }
.hh-note { font-size: 20rpx; color: var(--text-dim); margin-top: 8rpx; }

.health-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.health-item:last-child { border-bottom: none; }
.hi-top { display: flex; align-items: center; }
.hi-name { font-size: 26rpx; font-weight: 500; flex: 1; }
.hi-value { font-size: 24rpx; color: var(--text-sub); }
.hi-note {
  font-size: 20rpx;
  color: var(--text-dim);
  margin-top: 8rpx;
  padding-left: 26rpx;
  line-height: 1.5;
}

/* ================= 底部 ================= */
.footer-tip {
  text-align: center;
  color: var(--text-dim);
  font-size: 20rpx;
  line-height: 1.8;
  padding: 10rpx 40rpx 30rpx;
}

.bottom-holder { height: 30rpx; }

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(14, 17, 22, 0.92);
  backdrop-filter: blur(12rpx);
  border-top: 1rpx solid var(--border);
}

.ab-fav {
  flex: 2;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  background: var(--gold-bg);
  color: var(--gold);
  font-size: 28rpx;
  font-weight: 600;
}

.ab-fav.is-fav {
  background: var(--card-hover);
  color: var(--text-sub);
  font-weight: 400;
}

.ab-refresh {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  background: var(--card-hover);
  color: var(--text);
  font-size: 28rpx;
}
