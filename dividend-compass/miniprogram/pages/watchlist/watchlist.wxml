<!--watchlist.wxml 我的关注：各模块自选集中呈现 + 管理模式（排序/删除）-->
<view class="page">

  <!-- 模块归属条 -->
  <view class="module-tag watch-tag">
    <view class="mt-ic"><ui-icon name="star" size="26" /></view>
    <text class="mt-name">我的关注</text>
    <text class="mt-cur manage-btn" bindtap="toggleManage">{{manageMode ? '完成' : '管理'}}</text>
  </view>

  <view wx:if="{{loading}}" class="wl-skeleton">
    <view class="skeleton sk-row"></view>
    <view class="skeleton sk-row"></view>
    <view class="skeleton sk-row"></view>
  </view>

  <view wx:elif="{{error}}" class="empty-box">
    <view>{{error}}</view>
    <view class="wl-retry" bindtap="load">重试</view>
  </view>

  <block wx:else>
    <!-- 贵金属现货（用户在拾金观察收藏的品种） -->
    <view class="card" wx:if="{{golds.length}}">
      <view class="card-title"><text>贵金属现货</text><text class="sub">来自拾金观察</text></view>
      <view class="wl-row" wx:for="{{golds}}" wx:key="code"
            data-gold="{{item.isGold}}" bindtap="goStock" hover-class="{{manageMode ? '' : 'press'}}">
        <view class="wl-moves" wx:if="{{manageMode}}">
          <view class="mv-btn dis">★</view>
        </view>
        <view class="wl-left">
          <view class="wl-name">{{item.name}}</view>
          <view class="wl-code">现货 · 拾金观察</view>
        </view>
        <view class="wl-right">
          <view class="wl-price num">{{item.price || '--'}}</view>
          <view class="wl-chg num {{item.changePercent > 0 ? 'up' : item.changePercent < 0 ? 'down' : 'flat'}}">
            {{item.changePercent == null ? '--' : (item.changePercent > 0 ? '+' : '') + item.changePercent + '%'}}
          </view>
        </view>
        <view class="wl-del" data-code="{{item.code}}" data-name="{{item.name}}" catchtap="goRemove">
          <ui-icon name="close" size="26" color="#59626d" />
        </view>
      </view>
    </view>

    <!-- 股票自选 -->
    <view class="card">
      <view class="card-title"><text>股票自选</text><text class="sub">{{manageMode ? '上下移动调整顺序' : (stocks.length ? stocks.length + ' 只' : '')}}</text></view>
      <view wx:if="{{!stocks.length}}" class="empty-box">暂无自选股票 · 在详情页可添加</view>
      <view class="wl-row" wx:for="{{stocks}}" wx:key="code"
            data-code="{{item.code}}" data-name="{{item.name}}" bindtap="goStock" hover-class="{{manageMode ? '' : 'press'}}">
        <view class="wl-moves" wx:if="{{manageMode}}">
          <view class="mv-btn {{idx === 0 ? 'dis' : ''}}" data-group="stocks" data-idx="{{index}}" data-dir="up" catchtap="moveRow">↑</view>
          <view class="mv-btn {{idx === stocks.length - 1 ? 'dis' : ''}}" data-group="stocks" data-idx="{{index}}" data-dir="down" catchtap="moveRow">↓</view>
        </view>
        <view class="wl-left">
          <view class="wl-name">{{item.name}}</view>
          <view class="wl-code num">{{item.market}} {{item.code}}</view>
        </view>
        <view class="wl-right">
          <view class="wl-price num">{{item.price || '--'}}</view>
          <view class="wl-chg num {{item.changePercent > 0 ? 'up' : item.changePercent < 0 ? 'down' : 'flat'}}">
            {{item.changePercent == null ? '--' : (item.changePercent > 0 ? '+' : '') + item.changePercent + '%'}}
          </view>
        </view>
        <view class="wl-del" data-code="{{item.code}}" data-name="{{item.name}}" catchtap="goRemove">
          <ui-icon name="close" size="26" color="#59626d" />
        </view>
      </view>
    </view>

    <!-- ETF/基金自选 -->
    <view class="card" wx:if="{{etfs.length}}">
      <view class="card-title"><text>ETF / 基金自选</text><text class="sub">{{etfs.length}} 只</text></view>
      <view class="wl-row" wx:for="{{etfs}}" wx:key="code"
            data-code="{{item.code}}" data-name="{{item.name}}" bindtap="goStock" hover-class="{{manageMode ? '' : 'press'}}">
        <view class="wl-moves" wx:if="{{manageMode}}">
          <view class="mv-btn {{idx === 0 ? 'dis' : ''}}" data-group="etfs" data-idx="{{index}}" data-dir="up" catchtap="moveRow">↑</view>
          <view class="mv-btn {{idx === etfs.length - 1 ? 'dis' : ''}}" data-group="etfs" data-idx="{{index}}" data-dir="down" catchtap="moveRow">↓</view>
        </view>
        <view class="wl-left">
          <view class="wl-name">{{item.name}}</view>
          <view class="wl-code num">{{item.market}} {{item.code}}</view>
        </view>
        <view class="wl-right">
          <view class="wl-price num">{{item.price || '--'}}</view>
          <view class="wl-chg num {{item.changePercent > 0 ? 'up' : item.changePercent < 0 ? 'down' : 'flat'}}">
            {{item.changePercent == null ? '--' : (item.changePercent > 0 ? '+' : '') + item.changePercent + '%'}}
          </view>
        </view>
        <view class="wl-del" data-code="{{item.code}}" data-name="{{item.name}}" catchtap="goRemove">
          <ui-icon name="close" size="26" color="#59626d" />
        </view>
      </view>
    </view>

    <view class="footer-tip">
      <view>{{manageMode ? '管理中：↑↓ 调整顺序（自动保存），✕ 移除关注' : '点「管理」可自定义排序与移除 · 数据以最新刷新为准'}}</view>
    </view>
  </block>

  <module-switcher current="watch" />
</view>
