/* 年度收息报告 */
.page { min-height: 100vh; padding-bottom: 60rpx; }
.empty-sub { font-size: 22rpx; color: var(--text-dim); margin-top: 10rpx; }
.go-btn {
  margin-top: 30rpx;
  background: var(--gold-bg);
  color: var(--gold);
  font-size: 26rpx;
  padding: 0 50rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
}

/* 报告主卡 */
.rp-hero {
  text-align: center;
  background: linear-gradient(160deg, rgba(212, 169, 78, 0.12), var(--card) 60%);
  padding: 40rpx 30rpx;
}
.rp-year { font-size: 30rpx; font-weight: 700; color: #e8b95f; }
.rp-label { font-size: 22rpx; color: var(--text-sub); margin-top: 24rpx; }
.rp-total { font-size: 76rpx; font-weight: 700; color: var(--gold); margin-top: 8rpx; }
.rp-unit { font-size: 26rpx; font-weight: 400; margin-left: 8rpx; }
.rp-facts { font-size: 22rpx; color: var(--text-sub); margin-top: 16rpx; }

/* 月份条形 */
.bar-chart {
  display: flex;
  align-items: flex-end;
  height: 240rpx;
  gap: 6rpx;
}
.bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
}
.bar-val { font-size: 16rpx; color: var(--text-sub); margin-bottom: 4rpx; }
.bar {
  width: 70%;
  background: linear-gradient(180deg, #d4a94e, rgba(212, 169, 78, 0.35));
  border-radius: 6rpx 6rpx 0 0;
  min-height: 6rpx;
}
.bar-label { font-size: 18rpx; color: var(--text-dim); margin-top: 8rpx; }

/* 个股明细 */
.rp-row {
  display: flex;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(148, 163, 184, 0.1);
}
.rp-row:last-of-type { border-bottom: none; }
.rp-name { font-size: 27rpx; }
.rp-amt { font-size: 27rpx; font-weight: 600; color: var(--gold); }

/* 收息成就 */
.ach-row { display: flex; gap: 16rpx; }
.ach-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 8rpx;
  background: var(--bg);
  border-radius: 12rpx;
  border: 1rpx solid transparent;
  opacity: 0.55;
}
.ach-item.on {
  opacity: 1;
  background: rgba(212, 169, 78, 0.08);
  border-color: rgba(212, 169, 78, 0.35);
}
.ach-icon { font-size: 40rpx; }
.ach-label { font-size: 24rpx; font-weight: 600; margin-top: 8rpx; color: #e8b95f; }
.ach-desc { font-size: 18rpx; color: var(--text-dim); margin-top: 6rpx; text-align: center; }

/* 分享卡 */
.share-btn {
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  background: var(--gold);
  color: #1a1d24;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 42rpx;
}
.cv-note { font-size: 20rpx; color: var(--text-dim); margin-top: 14rpx; line-height: 1.6; }
.rp-canvas {
  width: 750rpx;
  height: 1000rpx;
  position: fixed;
  left: -9999rpx;
  top: 0;
}
