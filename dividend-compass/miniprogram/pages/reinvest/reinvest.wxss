/* 分红再投模拟页 */
.page { min-height: 100vh; padding-bottom: 60rpx; }
.footer-tip {
  padding: 10rpx 40rpx 40rpx;
  font-size: 20rpx;
  color: var(--text-dim);
  line-height: 1.8;
  text-align: center;
}
.cv-note { font-size: 20rpx; color: var(--text-dim); margin-top: 12rpx; }

/* 参数 */
.ri-params { display: flex; align-items: flex-end; gap: 24rpx; }
.ri-field { flex: 1; }
.ri-label { font-size: 20rpx; color: var(--text-dim); }
.ri-in {
  margin-top: 8rpx;
  background: var(--bg);
  border-radius: 10rpx;
  height: 72rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.ri-years { display: flex; gap: 12rpx; padding-bottom: 14rpx; }
.rt {
  font-size: 22rpx;
  padding: 10rpx 24rpx;
  border-radius: 8rpx;
  color: var(--text-dim);
  background: rgba(148, 163, 184, 0.10);
}
.rt.on { color: #e8b95f; background: rgba(212, 169, 78, 0.15); font-weight: 600; }

/* 对比 */
.ri-two {
  display: flex;
  align-items: stretch;
  padding: 8rpx 0 4rpx;
}
.ri-col { flex: 1; text-align: center; }
.ri-col-title { font-size: 24rpx; font-weight: 600; }
.ri-val { font-size: 44rpx; font-weight: 700; margin-top: 10rpx; }
.ri-sub { font-size: 26rpx; font-weight: 600; margin-top: 4rpx; }
.ri-note { font-size: 20rpx; color: var(--text-dim); margin-top: 8rpx; }
.ri-vs {
  width: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-dim);
}
.ri-conclusion {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: var(--bg);
  border-radius: 10rpx;
  font-size: 22rpx;
  color: var(--text-sub);
  line-height: 1.6;
}

/* 画布 */
.cv-wrap { width: 100%; }
.ri-cv { width: 100%; height: 440rpx; }
.gold-text { color: var(--gold); }
