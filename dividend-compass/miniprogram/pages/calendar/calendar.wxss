/* 分红日历 */
.page { min-height: 100vh; }
.retry-btn {
  margin-top: 30rpx;
  background: var(--gold-bg);
  color: var(--gold);
  font-size: 26rpx;
  padding: 0 50rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
}
.footer-tip {
  padding: 20rpx 40rpx 60rpx;
  font-size: 20rpx;
  color: var(--text-dim);
  line-height: 1.7;
  text-align: center;
}

.cal-tabs {
  display: flex;
  background: #171b22;
  border-radius: 14rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}
.cal-tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-dim);
  padding: 14rpx 0;
  border-radius: 10rpx;
}
.cal-tab.on {
  background: rgba(212, 169, 78, 0.15);
  color: #e8b95f;
  font-weight: 600;
}
.cal-badge {
  display: inline-block;
  margin-left: 8rpx;
  padding: 0 10rpx;
  height: 30rpx;
  line-height: 30rpx;
  font-size: 20rpx;
  color: #1a1d24;
  background: #d4a94e;
  border-radius: 8rpx;
  vertical-align: 4rpx;
}

/* 自选分红事件 */
.fav-ev {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(148, 163, 184, 0.1);
}
.fav-ev:last-child { border-bottom: none; }
.fe-date { flex: 1; }
.fe-date-text { font-size: 26rpx; font-weight: 600; }
.fe-date-text.plan { color: var(--text-dim); font-weight: 400; }
.fe-profile { font-size: 20rpx; color: var(--text-dim); margin-top: 4rpx; }
.fe-right { text-align: right; }
.fe-per { font-size: 26rpx; font-weight: 600; color: var(--gold); }
.fe-tag {
  display: inline-block;
  margin-top: 6rpx;
  padding: 2rpx 12rpx;
  font-size: 18rpx;
  border-radius: 6rpx;
  color: #e8b95f;
  background: rgba(212, 169, 78, 0.14);
}
.fe-tag.plan { color: var(--text-dim); background: rgba(148, 163, 184, 0.12); }

/* 全市场行 */
.mkt-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(148, 163, 184, 0.1);
}
.mkt-row:last-child { border-bottom: none; }
.mr-left { flex: 1; }
.mr-name { font-size: 26rpx; margin-right: 12rpx; }
.mr-code { font-size: 20rpx; color: var(--text-dim); }
.mr-per { font-size: 24rpx; color: var(--gold); }

.empty-sub { font-size: 20rpx; color: var(--text-dim); margin-top: 10rpx; }
