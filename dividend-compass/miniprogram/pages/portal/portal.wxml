<!--portal.wxml 模块门户：策略模块调度中心（黑金终端风）-->
<view class="page">

  <view class="pt-head">
    <view class="pt-t">今天看点什么？</view>
    <view class="pt-s">你的收息与配置，各归一处</view>
  </view>

  <view wx:if="{{loading}}" class="pt-skeleton">
    <view class="skeleton pt-sk"></view>
    <view class="skeleton pt-sk"></view>
  </view>

  <view wx:elif="{{error}}" class="empty-box">
    <view>模块摘要加载失败</view>
    <view class="pt-err">{{error}}</view>
    <view class="pt-retry" bindtap="load">重试</view>
  </view>

  <block wx:else>
    <view class="pt-label">核心模块</view>

    <!-- 拾息红利 -->
    <view class="mod mod-stock" hover-class="press" bindtap="goStrategy">
      <image class="deco-img" mode="aspectFit" src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%20200%20160'%3E%3Cdefs%3E%3ClinearGradient%20id='g'%20x1='0'%20y1='0'%20x2='0'%20y2='1'%3E%3Cstop%20offset='0'%20stop-color='%234C8DFF'%20stop-opacity='.38'/%3E%3Cstop%20offset='1'%20stop-color='%234C8DFF'%20stop-opacity='0'/%3E%3C/linearGradient%3E%3C/defs%3E%3Cpath%20d='M0%20140C34%20132%2054%20106%2082%2090C110%2074%20136%2056%20196%2024L196%20160L0%20160Z'%20fill='url(%23g)'/%3E%3Cpath%20d='M0%20140C34%20132%2054%20106%2082%2090C110%2074%20136%2056%20196%2024'%20stroke='%239FC1F0'%20stroke-width='4'%20fill='none'%20stroke-linecap='round'/%3E%3Ccircle%20cx='194'%20cy='26'%20r='5'%20fill='%23C7DDFB'/%3E%3Ccircle%20cx='194'%20cy='26'%20r='10'%20fill='none'%20stroke='%239FC1F0'%20stroke-opacity='.45'/%3E%3C/svg%3E" />
      <view class="mod-row">
        <view class="mod-ic stock-ic-solid"><ui-icon name="chart" size="44" color="#0a0d12" /></view>
        <view class="mod-info">
          <view class="mod-name">拾息红利</view>
          <view class="mod-desc">行情 · 筛选 · 日历 · 记账 · 提醒</view>
        </view>
        <view class="mod-arr">›</view>
      </view>
      <view class="mod-foot" wx:if="{{stockSummary}}">
        <text class="mchip">今日除息 {{stockSummary.exTodayCount}} 只</text>
        <text class="mchip">派现 {{stockSummary.exCash}}</text>
        <text class="mchip g">中证红利 {{stockSummary.csiText}}</text>
      </view>
    </view>

    <!-- 拾金观察 -->
    <view class="mod mod-gold" hover-class="press" bindtap="goGold">
      <image class="deco-img" mode="aspectFit" src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%20200%20160'%3E%3Cdefs%3E%3ClinearGradient%20id='gg'%20x1='0'%20y1='0'%20x2='0'%20y2='1'%3E%3Cstop%20offset='0'%20stop-color='%23F5DCA6'/%3E%3Cstop%20offset='1'%20stop-color='%239A7420'/%3E%3C/linearGradient%3E%3CradialGradient%20id='halo'%3E%3Cstop%20offset='0'%20stop-color='%23D4A94E'%20stop-opacity='.3'/%3E%3Cstop%20offset='1'%20stop-color='%23D4A94E'%20stop-opacity='0'/%3E%3C/radialGradient%3E%3C/defs%3E%3Ccircle%20cx='140'%20cy='55'%20r='70'%20fill='url(%23halo)'/%3E%3Cpolygon%20points='34,146%2052,112%20148,112%20166,146'%20fill='url(%23gg)'/%3E%3Cpolygon%20points='52,112%20148,112%20144,104%2056,104'%20fill='%23F8E7BD'/%3E%3Cpolygon%20points='62,104%2074,72%20126,72%20138,104'%20fill='url(%23gg)'/%3E%3Cpolygon%20points='74,72%20126,72%20123,66%2077,66'%20fill='%23F8E7BD'/%3E%3Cpath%20d='M40%2030L44%2038L52%2042L44%2046L40%2054L36%2046L28%2042L36%2038Z'%20fill='%23F8E7BD'/%3E%3Ccircle%20cx='70'%20cy='24'%20r='3'%20fill='%23F8E7BD'/%3E%3C/svg%3E" />
      <view class="mod-row">
        <view class="mod-ic gold-ic-solid"><ui-icon name="gold" size="44" color="#1a1206" /></view>
        <view class="mod-info">
          <view class="mod-name">拾金观察</view>
          <view class="mod-desc">金价 · 走势 · ETF 配置</view>
        </view>
        <view class="mod-arr">›</view>
      </view>
      <view class="mod-foot" wx:if="{{goldSummary}}">
        <text class="mchip g">上海金 {{goldSummary.price}} 元/克</text>
        <text class="mchip {{goldSummary.chgCls}}">{{goldSummary.chgPct}}</text>
      </view>
    </view>

    <!-- 我的关注 -->
    <view class="mod mod-watch" hover-class="press" bindtap="goWatchlist">
      <view class="mod-row">
        <view class="mod-ic watch-ic-solid"><ui-icon name="star" size="44" color="#1a1206" /></view>
        <view class="mod-info">
          <view class="mod-name">我的关注</view>
          <view class="mod-desc">各模块自选集中呈现 · 行情一眼看全</view>
        </view>
        <view class="mod-arr">›</view>
      </view>
      <view class="mod-foot" wx:if="{{watchCount > 0 || goldSummary}}">
        <text class="mchip g" wx:if="{{watchCount > 0}}">自选 {{watchCount}} 只</text>
        <text class="mchip g" wx:if="{{goldSummary}}">上海金 {{goldSummary.price}} 元/克</text>
      </view>
    </view>

    <view class="pt-tip">进入模块后，点击右下角 ⇄ 可随时切换</view>
  </block>

  <module-switcher current="" />
</view>
