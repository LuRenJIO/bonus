<!--portal.wxml 模块门户：策略模块调度中心（黑金终端风）-->
<view class="page">

  <view class="pt-head">
    <view class="pt-t">今天看点什么？</view>
    <view class="pt-s">你的收息与配置，各归一处</view>
  </view>

  <view wx:if="{{loading}}" class="pt-skeleton">
    <view class="skeleton pt-sk"></view>
    <view class="skeleton pt-sk"></view>
  </view>

  <view wx:elif="{{error}}" class="empty-box">
    <view>模块摘要加载失败</view>
    <view class="pt-err">{{error}}</view>
    <view class="pt-retry" bindtap="load">重试</view>
  </view>

  <block wx:else>
    <view class="pt-label">核心模块</view>

    <!-- 拾息红利 -->
    <view class="mod mod-stock" hover-class="press" bindtap="goStrategy">
      <view class="deco-kline">
        <view class="kgrid"></view>
        <view class="kline k1"><view class="kw"></view><view class="kb up"></view></view>
        <view class="kline k2"><view class="kw"></view><view class="kb dn"></view></view>
        <view class="kline k3"><view class="kw"></view><view class="kb up hi"></view></view>
        <view class="kline k4"><view class="kw"></view><view class="kb up"></view></view>
        <view class="kbase"></view>
      </view>
      <view class="mod-row">
        <view class="mod-ic stock-ic-solid"><ui-icon name="chart" size="44" color="#0a0d12" /></view>
        <view class="mod-info">
          <view class="mod-name">拾息红利</view>
          <view class="mod-desc">行情 · 筛选 · 日历 · 记账 · 提醒</view>
        </view>
        <view class="mod-arr">›</view>
      </view>
      <view class="mod-foot" wx:if="{{stockSummary}}">
        <text class="mchip">今日除息 {{stockSummary.exTodayCount}} 只</text>
        <text class="mchip">派现 {{stockSummary.exCash}}</text>
        <text class="mchip g">中证红利 {{stockSummary.csiText}}</text>
      </view>
    </view>

    <!-- 拾金观察 -->
    <view class="mod mod-gold" hover-class="press" bindtap="goGold">
      <view class="deco-ingot">
        <view class="ishadow"></view>
        <view class="ingot ig3"><view class="itop"></view></view>
        <view class="ingot ig2"><view class="itop"></view><view class="iside"></view></view>
        <view class="ingot ig1"><view class="itop"></view><view class="iside"></view></view>
        <view class="ispark sp1"></view>
        <view class="ispark sp2"></view>
      </view>
      <view class="mod-row">
        <view class="mod-ic gold-ic-solid"><ui-icon name="gold" size="44" color="#1a1206" /></view>
        <view class="mod-info">
          <view class="mod-name">拾金观察</view>
          <view class="mod-desc">金价 · 走势 · ETF 配置</view>
        </view>
        <view class="mod-arr">›</view>
      </view>
      <view class="mod-foot" wx:if="{{goldSummary}}">
        <text class="mchip g">上海金 {{goldSummary.price}} 元/克</text>
        <text class="mchip {{goldSummary.chgCls}}">{{goldSummary.chgPct}}</text>
      </view>
    </view>

    <!-- 我的关注 -->
    <view class="mod mod-watch" hover-class="press" bindtap="goWatchlist">
      <view class="deco-stars">
        <view class="star-outline"></view>
        <view class="star st1"></view>
        <view class="star st2"></view>
        <view class="star st3"></view>
      </view>
      <view class="mod-row">
        <view class="mod-ic watch-ic-solid"><ui-icon name="star" size="44" color="#1a1206" /></view>
        <view class="mod-info">
          <view class="mod-name">我的关注</view>
          <view class="mod-desc">各模块自选集中呈现 · 行情一眼看全</view>
        </view>
        <view class="mod-arr">›</view>
      </view>
      <view class="mod-foot" wx:if="{{watchCount > 0 || goldSummary}}">
        <text class="mchip g" wx:if="{{watchCount > 0}}">自选 {{watchCount}} 只</text>
        <text class="mchip g" wx:if="{{goldSummary}}">上海金 {{goldSummary.price}} 元/克</text>
      </view>
    </view>

    <view class="pt-tip">进入模块后，点击右下角 ⇄ 可随时切换</view>

    <!-- 反馈 -->
    <view class="pt-footer">
      <view>数据来源：东方财富 · 腾讯财经 · 新浪财经 ｜ 仅供研究参考，不构成投资建议</view>
      <button class="pt-feedback" open-type="feedback" plain>意见反馈</button>
    </view>
  </block>

  <module-switcher current="" />
</view>
