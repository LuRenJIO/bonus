/* portal.wxss 模块门户（黑金终端风） */
.page {
  min-height: 100vh;
  background: #050608;
  background-image: linear-gradient(rgba(27, 34, 44, 0.5) 1px, transparent 1px),
    linear-gradient(90deg, rgba(27, 34, 44, 0.5) 1px, transparent 1px);
  background-size: 48rpx 48rpx;
  padding-bottom: 140rpx;
}

.pt-head { padding: 36rpx 32rpx 10rpx; }
.pt-k { font-size: 20rpx; color: var(--text-dim); letter-spacing: 4rpx; }
.pt-t { font-size: 44rpx; font-weight: 700; color: var(--text); margin-top: 6rpx; }
.pt-dot { color: var(--gold-hi); }
.pt-s { font-size: 23rpx; color: var(--text-sub); margin-top: 8rpx; }

.pt-label {
  font-size: 21rpx;
  color: var(--text-dim);
  letter-spacing: 3rpx;
  padding: 24rpx 32rpx 12rpx;
}

/* 模块卡 */
.mod {
  position: relative;
  overflow: hidden;
  margin: 0 24rpx 20rpx;
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--lineh, #2a3442);
  padding: 26rpx;
  transition: transform 0.12s ease;
}
.mod-stock { background: linear-gradient(135deg, #101820, #0a0d12); }
.mod-gold {
  background: linear-gradient(135deg, #221b0e, #0e0b06);
  border-color: #3d3018;
}
.mod-soon { border-style: dashed; opacity: 0.6; }

/* —— 卡片装饰层（纯 CSS，零资源） —— */
.deco {
  position: absolute;
  right: -6rpx;
  top: -10rpx;
  width: 200rpx;
  height: 170rpx;
  pointer-events: none;
}

/* 拾息红利：标准 K 线（影线 + 实体，红涨绿跌语义淡化为蓝/灰蓝主题色） */
.deco-stock .kgroup {
  position: absolute;
  right: 10rpx;
  bottom: 6rpx;
  width: 168rpx;
  height: 150rpx;
  border-bottom: 1rpx solid rgba(76, 141, 255, 0.3);
}
.deco-stock .kline {
  position: absolute;
  bottom: 0;
  width: 26rpx;
  height: 100%;
}
.kl1 { right: 8rpx; } .kl2 { right: 50rpx; } .kl3 { right: 92rpx; } .kl4 { right: 134rpx; }
.kwire {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  width: 2rpx;
  height: 100%;
  background: rgba(76, 141, 255, 0.35);
}
.kbody {
  position: absolute;
  left: 0;
  width: 100%;
  border-radius: 3rpx;
}
.kb-up {
  background: linear-gradient(180deg, rgba(120, 175, 255, 0.75), rgba(76, 141, 255, 0.3));
  box-shadow: 0 0 10rpx rgba(76, 141, 255, 0.25);
}
.kb-dn { background: rgba(90, 105, 125, 0.55); }
.kl1 .kbody { bottom: 26rpx; height: 58rpx; }
.kl2 .kbody { bottom: 48rpx; height: 40rpx; }
.kl3 .kbody { bottom: 34rpx; height: 66rpx; }
.kl4 .kbody { bottom: 20rpx; height: 84rpx; }

/* 拾金观察：金锭三叠（梯形堆叠 + 顶面高光 + 光点） */
.deco-gold .ingot {
  position: absolute;
  background: linear-gradient(180deg, #f0d08a 0%, #d4a94e 55%, #9a7420 100%);
  clip-path: polygon(18% 0, 82% 0, 100% 100%, 0 100%);
  box-shadow: 0 4rpx 14rpx rgba(212, 169, 78, 0.35);
}
.deco-gold .ingot::before {
  content: "";
  position: absolute;
  top: 3rpx; left: 12%; right: 12%;
  height: 5rpx;
  border-radius: 3rpx;
  background: rgba(255, 244, 214, 0.75);
}
.deco-gold .ig1 { right: 4rpx; bottom: 4rpx; width: 150rpx; height: 44rpx; }
.deco-gold .ig2 { right: 26rpx; bottom: 52rpx; width: 112rpx; height: 40rpx; }
.deco-gold .ig3 { right: 46rpx; bottom: 96rpx; width: 84rpx; height: 36rpx; }
.deco-gold .spark {
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #fff3d6;
  box-shadow: 0 0 10rpx rgba(255, 243, 214, 0.9);
}
.deco-gold .s1 { right: 10rpx; top: 10rpx; }
.deco-gold .s2 { right: 150rpx; bottom: 30rpx; opacity: 0.6; }

/* 我的关注：星标容器 */
.watch-ic-solid {
  background: linear-gradient(135deg, #b8e0c8, #4fbf8b);
  box-shadow: 0 6rpx 18rpx rgba(79, 191, 139, 0.3);
}

.mod-row { display: flex; align-items: center; gap: 22rpx; position: relative; z-index: 1; }
.mod-ic {
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
/* 实底亮色图标容器（深色图标，对比更强） */
.stock-ic-solid {
  background: linear-gradient(135deg, #9fc1f0, #4c8dff);
  box-shadow: 0 6rpx 18rpx rgba(76, 141, 255, 0.3);
}
.gold-ic-solid {
  background: var(--gold-grad);
  box-shadow: 0 6rpx 18rpx rgba(212, 169, 78, 0.35);
}
.soon-ic {
  border: 1rpx dashed var(--border);
  background: transparent;
}

.mod-info { flex: 1; }
.mod-name { font-size: 30rpx; font-weight: 600; color: var(--text); }
.soon-name { color: var(--text-sub); }
.mod-desc { font-size: 21rpx; color: var(--text-dim); margin-top: 6rpx; line-height: 1.5; }
.mod-arr { color: var(--text-dim); font-size: 34rpx; }

.mod-foot {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(27, 34, 44, 0.8);
  flex-wrap: wrap;
}
.mchip {
  font-size: 19rpx;
  color: var(--text-sub);
  border: 1rpx solid var(--lineh, #2a3442);
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
}
.mchip.g { color: var(--gold); border-color: rgba(212, 169, 78, 0.3); }
.mchip.up { color: var(--up); border-color: rgba(240, 75, 90, 0.3); }
.mchip.dn { color: var(--down); border-color: rgba(0, 181, 120, 0.3); }

.pt-tip {
  padding: 10rpx 32rpx;
  font-size: 20rpx;
  color: var(--text-dim);
  text-align: center;
  line-height: 1.6;
}
.pt-err { color: var(--up); font-size: 21rpx; margin-top: 10rpx; }
.pt-retry {
  margin: 20rpx auto 0;
  width: 180rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border: 1rpx solid var(--border);
  border-radius: 32rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}

.pt-skeleton { padding: 10rpx 24rpx; }
.pt-sk { height: 180rpx; margin-bottom: 20rpx; }
