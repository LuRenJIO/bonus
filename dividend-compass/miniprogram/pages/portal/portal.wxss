/* portal.wxss 模块门户（黑金终端风） */
.page {
  min-height: 100vh;
  background: #050608;
  background-image: linear-gradient(rgba(27, 34, 44, 0.5) 1px, transparent 1px),
    linear-gradient(90deg, rgba(27, 34, 44, 0.5) 1px, transparent 1px);
  background-size: 48rpx 48rpx;
  padding-bottom: 140rpx;
}

.pt-head { padding: 36rpx 32rpx 10rpx; }
.pt-k { font-size: 20rpx; color: var(--text-dim); letter-spacing: 4rpx; }
.pt-t { font-size: 44rpx; font-weight: 700; color: var(--text); margin-top: 6rpx; }
.pt-dot { color: var(--gold-hi); }
.pt-s { font-size: 23rpx; color: var(--text-sub); margin-top: 8rpx; }

.pt-label {
  font-size: 21rpx;
  color: var(--text-dim);
  letter-spacing: 3rpx;
  padding: 24rpx 32rpx 12rpx;
}

/* 模块卡 */
.mod {
  position: relative;
  overflow: hidden;
  margin: 0 24rpx 20rpx;
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--lineh, #2a3442);
  padding: 26rpx;
  transition: transform 0.12s ease;
}
.mod-stock { background: linear-gradient(135deg, #101820, #0a0d12); }
.mod-gold {
  background: linear-gradient(135deg, #221b0e, #0e0b06);
  border-color: #3d3018;
}
.mod-soon { border-style: dashed; opacity: 0.6; }

/* —— 卡片装饰层（纯 CSS，零资源） —— */
.deco {
  position: absolute;
  right: -6rpx;
  top: -10rpx;
  width: 200rpx;
  height: 170rpx;
  pointer-events: none;
}

/* 拾息红利：K线柱群（蓝渐变错落 + 底部基准线） */
.deco-stock .kbar {
  position: absolute;
  bottom: 0;
  width: 18rpx;
  border-radius: 4rpx 4rpx 0 0;
  background: linear-gradient(180deg, rgba(76, 141, 255, 0.42), rgba(76, 141, 255, 0.05));
}
.deco-stock .k1 { right: 18rpx; height: 64rpx; }
.deco-stock .k2 { right: 52rpx; height: 104rpx; }
.deco-stock .k3 { right: 86rpx; height: 82rpx; }
.deco-stock .k4 { right: 120rpx; height: 128rpx; }
.deco-stock::after {
  content: "";
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 1rpx;
  background: rgba(76, 141, 255, 0.28);
}

/* 拾金观察：双金币（金渐变 + 内环 + ¥ + 光晕） */
.deco-gold .coin {
  position: absolute;
  border-radius: 50%;
  background: linear-gradient(135deg, #f0d08a, #b8860b);
  box-shadow: 0 0 30rpx rgba(212, 169, 78, 0.38);
}
.deco-gold .coin::before {
  content: "";
  position: absolute;
  inset: 8rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(90, 60, 10, 0.35);
}
.deco-gold .c1 {
  right: 14rpx;
  top: 6rpx;
  width: 104rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.deco-gold .c2 {
  right: 88rpx;
  top: 62rpx;
  width: 56rpx;
  height: 56rpx;
  opacity: 0.5;
}
.coin-y {
  font-family: 'DIN Alternate', 'Menlo', monospace;
  font-size: 40rpx;
  font-weight: 700;
  color: rgba(90, 60, 10, 0.55);
}

.mod-row { display: flex; align-items: center; gap: 22rpx; position: relative; z-index: 1; }
.mod-ic {
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
/* 实底亮色图标容器（深色图标，对比更强） */
.stock-ic-solid {
  background: linear-gradient(135deg, #9fc1f0, #4c8dff);
  box-shadow: 0 6rpx 18rpx rgba(76, 141, 255, 0.3);
}
.gold-ic-solid {
  background: var(--gold-grad);
  box-shadow: 0 6rpx 18rpx rgba(212, 169, 78, 0.35);
}
.soon-ic {
  border: 1rpx dashed var(--border);
  background: transparent;
}

.mod-info { flex: 1; }
.mod-name { font-size: 30rpx; font-weight: 600; color: var(--text); }
.soon-name { color: var(--text-sub); }
.mod-desc { font-size: 21rpx; color: var(--text-dim); margin-top: 6rpx; line-height: 1.5; }
.mod-arr { color: var(--text-dim); font-size: 34rpx; }

.mod-foot {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(27, 34, 44, 0.8);
  flex-wrap: wrap;
}
.mchip {
  font-size: 19rpx;
  color: var(--text-sub);
  border: 1rpx solid var(--lineh, #2a3442);
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
}
.mchip.g { color: var(--gold); border-color: rgba(212, 169, 78, 0.3); }
.mchip.up { color: var(--up); border-color: rgba(240, 75, 90, 0.3); }
.mchip.dn { color: var(--down); border-color: rgba(0, 181, 120, 0.3); }

.pt-tip {
  padding: 10rpx 32rpx;
  font-size: 20rpx;
  color: var(--text-dim);
  text-align: center;
  line-height: 1.6;
}
.pt-err { color: var(--up); font-size: 21rpx; margin-top: 10rpx; }
.pt-retry {
  margin: 20rpx auto 0;
  width: 180rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border: 1rpx solid var(--border);
  border-radius: 32rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}

.pt-skeleton { padding: 10rpx 24rpx; }
.pt-sk { height: 180rpx; margin-bottom: 20rpx; }
