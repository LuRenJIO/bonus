/* portal.wxss 模块门户（黑金终端风） */
.page {
  min-height: 100vh;
  background:
    radial-gradient(ellipse 120% 60% at 50% -10%, rgba(212, 169, 78, 0.13), transparent 60%),
    radial-gradient(ellipse 80% 50% at 90% 110%, rgba(76, 141, 255, 0.09), transparent 60%),
    #050608;
  padding-bottom: 140rpx;
}

.pt-head { padding: 36rpx 32rpx 10rpx; }
.pt-k { font-size: 20rpx; color: var(--text-dim); letter-spacing: 4rpx; }
.pt-t { font-size: 44rpx; font-weight: 700; color: var(--text); margin-top: 6rpx; }
.pt-dot { color: var(--gold-hi); }
.pt-s { font-size: 23rpx; color: var(--text-sub); margin-top: 8rpx; }

.pt-label {
  font-size: 21rpx;
  color: var(--text-dim);
  letter-spacing: 3rpx;
  padding: 24rpx 32rpx 12rpx;
}

/* 模块卡 */
.mod {
  position: relative;
  overflow: hidden;
  margin: 0 24rpx 20rpx;
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--lineh, #2a3442);
  padding: 26rpx;
  transition: transform 0.12s ease;
}
.mod-stock { background: linear-gradient(135deg, #101820, #0a0d12); }
.mod-gold {
  background: linear-gradient(135deg, #221b0e, #0e0b06);
  border-color: #3d3018;
}
.mod-soon { border-style: dashed; opacity: 0.6; }

/* —— 卡片抽象装饰：主题色光斑 + 圆环 + 光点（纯 CSS，全端渲染一致） —— */
.mod-glow {
  position: absolute;
  right: -50rpx;
  top: -60rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  pointer-events: none;
}
.stock-glow { background: radial-gradient(circle, rgba(76, 141, 255, 0.22), transparent 70%); }
.gold-glow-bg { background: radial-gradient(circle, rgba(212, 169, 78, 0.24), transparent 70%); }
.watch-glow { background: radial-gradient(circle, rgba(79, 191, 139, 0.2), transparent 70%); }

.mod-ring {
  position: absolute;
  right: 36rpx;
  top: 22rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  pointer-events: none;
}
.stock-ring { border: 1.5rpx solid rgba(120, 175, 255, 0.3); }
.gold-ring { border: 1.5rpx solid rgba(240, 208, 138, 0.32); }
.watch-ring { border: 1.5rpx solid rgba(127, 216, 168, 0.3); }

.mod-dot {
  position: absolute;
  right: 116rpx;
  top: 92rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  pointer-events: none;
}
.stock-dot { background: #9fc1f0; box-shadow: 0 0 12rpx rgba(120, 175, 255, 0.8); }
.gold-dot { background: var(--gold-hi); box-shadow: 0 0 12rpx rgba(240, 208, 138, 0.8); }
.watch-dot { background: #7fd8a8; box-shadow: 0 0 12rpx rgba(127, 216, 168, 0.8); }

/* 我的关注：星标容器 */
.watch-ic-solid {
  background: linear-gradient(135deg, #b8e0c8, #4fbf8b);
  box-shadow: 0 6rpx 18rpx rgba(79, 191, 139, 0.3);
}

.mod-row { display: flex; align-items: center; gap: 22rpx; position: relative; z-index: 1; }
.mod-ic {
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
/* 实底亮色图标容器（深色图标，对比更强） */
.stock-ic-solid {
  background: linear-gradient(135deg, #9fc1f0, #4c8dff);
  box-shadow: 0 6rpx 18rpx rgba(76, 141, 255, 0.3);
}
.gold-ic-solid {
  background: var(--gold-grad);
  box-shadow: 0 6rpx 18rpx rgba(212, 169, 78, 0.35);
}
.soon-ic {
  border: 1rpx dashed var(--border);
  background: transparent;
}

.mod-info { flex: 1; }
.mod-name { font-size: 30rpx; font-weight: 600; color: var(--text); }
.soon-name { color: var(--text-sub); }
.mod-desc { font-size: 21rpx; color: var(--text-dim); margin-top: 6rpx; line-height: 1.5; }
.mod-arr { color: var(--text-dim); font-size: 34rpx; }

.mod-foot {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(27, 34, 44, 0.8);
  flex-wrap: wrap;
}
.mchip {
  font-size: 19rpx;
  color: var(--text-sub);
  border: 1rpx solid var(--lineh, #2a3442);
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
}
.mchip.g { color: var(--gold); border-color: rgba(212, 169, 78, 0.3); }
.mchip.up { color: var(--up); border-color: rgba(240, 75, 90, 0.3); }
.mchip.dn { color: var(--down); border-color: rgba(0, 181, 120, 0.3); }

.pt-tip {
  padding: 10rpx 32rpx;
  font-size: 20rpx;
  color: var(--text-dim);
  text-align: center;
  line-height: 1.6;
}
.pt-footer {
  padding: 20rpx 40rpx 30rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--text-dim);
  line-height: 1.8;
}
.pt-feedback {
  margin-top: 20rpx;
  width: 220rpx;
  height: 56rpx;
  line-height: 54rpx;
  font-size: 22rpx;
  color: var(--text-dim) !important;
  border-color: var(--border) !important;
  border-radius: 28rpx;
  padding: 0;
}
.pt-err { color: var(--up); font-size: 21rpx; margin-top: 10rpx; }
.pt-retry {
  margin: 20rpx auto 0;
  width: 180rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border: 1rpx solid var(--border);
  border-radius: 32rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}

.pt-skeleton { padding: 10rpx 24rpx; }
.pt-sk { height: 180rpx; margin-bottom: 20rpx; }
