/* portal.wxss 模块门户（黑金终端风） */
.page {
  min-height: 100vh;
  background:
    radial-gradient(ellipse 120% 60% at 50% -10%, rgba(212, 169, 78, 0.13), transparent 60%),
    radial-gradient(ellipse 80% 50% at 90% 110%, rgba(76, 141, 255, 0.09), transparent 60%),
    #050608;
  padding-bottom: 140rpx;
}

.pt-head { padding: 36rpx 32rpx 10rpx; }
.pt-k { font-size: 20rpx; color: var(--text-dim); letter-spacing: 4rpx; }
.pt-t { font-size: 44rpx; font-weight: 700; color: var(--text); margin-top: 6rpx; }
.pt-dot { color: var(--gold-hi); }
.pt-s { font-size: 23rpx; color: var(--text-sub); margin-top: 8rpx; }

.pt-label {
  font-size: 21rpx;
  color: var(--text-dim);
  letter-spacing: 3rpx;
  padding: 24rpx 32rpx 12rpx;
}

/* 模块卡 */
.mod {
  position: relative;
  overflow: hidden;
  margin: 0 24rpx 20rpx;
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--lineh, #2a3442);
  padding: 26rpx;
  transition: transform 0.12s ease;
}
.mod-stock { background: linear-gradient(135deg, #101820, #0a0d12); }
.mod-gold {
  background: linear-gradient(135deg, #221b0e, #0e0b06);
  border-color: #3d3018;
}
.mod-soon { border-style: dashed; opacity: 0.6; }

/* —— 卡片具象装饰（纯 CSS 精绘） —— */

/* 拾息红利：标准 K 线（影线 + 圆角实体 + 涨跌分色 + 基准线 + 网格） */
.deco-kline {
  position: absolute;
  right: 14rpx;
  bottom: 10rpx;
  width: 190rpx;
  height: 160rpx;
  pointer-events: none;
}
.kgrid {
  position: absolute;
  inset: 0;
  background-image: linear-gradient(rgba(76, 141, 255, 0.08) 1rpx, transparent 1rpx);
  background-size: 100% 32rpx;
}
.kbase {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(120, 175, 255, 0.4), transparent);
}
.kline {
  position: absolute;
  bottom: 0;
  width: 30rpx;
  height: 100%;
}
.k1 { right: 6rpx; } .k2 { right: 52rpx; } .k3 { right: 98rpx; } .k4 { right: 144rpx; }
.kw {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  width: 2rpx;
  background: rgba(190, 215, 255, 0.5);
}
.kbody {
  position: absolute;
  left: 0;
  width: 100%;
  border-radius: 3rpx;
}
.kb.up {
  background: linear-gradient(180deg, rgba(170, 205, 255, 0.95), rgba(76, 141, 255, 0.35));
  box-shadow: 0 0 14rpx rgba(76, 141, 255, 0.3), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.35);
}
.kb.dn { background: linear-gradient(180deg, rgba(100, 115, 135, 0.7), rgba(60, 72, 88, 0.4)); }
.kb.hi { box-shadow: 0 0 18rpx rgba(120, 175, 255, 0.55), inset 0 2rpx 2rpx rgba(255, 255, 255, 0.45); }
.k1 .kw { top: 20rpx; bottom: 0; }   .k1 .kb { bottom: 18rpx; height: 62rpx; }
.k2 .kw { top: 0; bottom: 30rpx; }   .k2 .kb { bottom: 44rpx; height: 46rpx; }
.k3 .kw { top: 8rpx; bottom: 0; }    .k3 .kb { bottom: 28rpx; height: 74rpx; }
.k4 .kw { top: 0; bottom: 0; }       .k4 .kb { bottom: 14rpx; height: 96rpx; }

/* 拾金观察：金锭三叠（立体分色 + 顶面高光 + 底座投影 + 光点） */
.deco-ingot {
  position: absolute;
  right: 10rpx;
  bottom: 10rpx;
  width: 200rpx;
  height: 160rpx;
  pointer-events: none;
}
.ishadow {
  position: absolute;
  right: 0;
  bottom: -6rpx;
  width: 190rpx;
  height: 26rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse, rgba(0, 0, 0, 0.5), transparent 70%);
}
.ingot {
  position: absolute;
  background: linear-gradient(115deg, #f8e7bd 0%, #e8c477 40%, #d4a94e 62%, #9a7420 100%);
  clip-path: polygon(14% 0, 86% 0, 100% 100%, 0 100%);
}
.ingot .itop {
  position: absolute;
  top: 0; left: 14%; right: 14%;
  height: 6rpx;
  background: linear-gradient(90deg, rgba(255, 248, 225, 0.95), rgba(255, 236, 190, 0.6));
  border-radius: 3rpx;
}
.ingot .iside {
  position: absolute;
  top: 0; bottom: 0;
  left: 0;
  width: 22%;
  background: linear-gradient(90deg, rgba(255, 250, 230, 0.5), transparent);
}
.ig1 { right: 2rpx; bottom: 6rpx; width: 158rpx; height: 48rpx; }
.ig2 { right: 34rpx; bottom: 56rpx; width: 118rpx; height: 42rpx; }
.ig3 { right: 56rpx; bottom: 100rpx; width: 86rpx; height: 36rpx; }
.ig3 .itop { left: 16%; right: 16%; }
.ispark {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #fff6dd;
  box-shadow: 0 0 14rpx rgba(255, 246, 221, 1);
}
.ispark.sp1 { right: 12rpx; top: 14rpx; }
.ispark.sp2 { right: 168rpx; bottom: 34rpx; opacity: 0.65; }

/* 我的关注：绿光星野 + 空心描边大五角星 */
.deco-stars { position: absolute; inset: 0; pointer-events: none; }
.star-outline {
  position: absolute;
  right: 26rpx;
  top: 16rpx;
  width: 96rpx;
  height: 92rpx;
  clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
  background: rgba(127, 216, 168, 0.65);
  filter: drop-shadow(0 0 10rpx rgba(127, 216, 168, 0.45));
}
.star-outline::after {
  content: "";
  position: absolute;
  left: 9rpx; right: 9rpx; top: 8rpx; bottom: 8rpx;
  clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
  background: #101a15;
}
.star {
  position: absolute;
  border-radius: 50%;
  background: #bdf0d3;
}
.st1 { right: 24rpx; top: 22rpx; width: 10rpx; height: 10rpx; box-shadow: 0 0 14rpx rgba(127, 216, 168, 1); }
.st2 { right: 92rpx; top: 52rpx; width: 7rpx; height: 7rpx; opacity: 0.7; box-shadow: 0 0 10rpx rgba(127, 216, 168, 0.8); }
.st3 { right: 52rpx; bottom: 30rpx; width: 6rpx; height: 6rpx; opacity: 0.5; }
.st4 { right: 150rpx; top: 40rpx; width: 5rpx; height: 5rpx; opacity: 0.4; }

/* 我的关注：星标容器 */
.watch-ic-solid {
  background: linear-gradient(135deg, #b8e0c8, #4fbf8b);
  box-shadow: 0 6rpx 18rpx rgba(79, 191, 139, 0.3);
}

.mod-row { display: flex; align-items: center; gap: 22rpx; position: relative; z-index: 1; }
.mod-ic {
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
/* 实底亮色图标容器（深色图标，对比更强） */
.stock-ic-solid {
  background: linear-gradient(135deg, #9fc1f0, #4c8dff);
  box-shadow: 0 6rpx 18rpx rgba(76, 141, 255, 0.3);
}
.gold-ic-solid {
  background: var(--gold-grad);
  box-shadow: 0 6rpx 18rpx rgba(212, 169, 78, 0.35);
}
.soon-ic {
  border: 1rpx dashed var(--border);
  background: transparent;
}

.mod-info { flex: 1; }
.mod-name { font-size: 30rpx; font-weight: 600; color: var(--text); }
.soon-name { color: var(--text-sub); }
.mod-desc { font-size: 21rpx; color: var(--text-dim); margin-top: 6rpx; line-height: 1.5; }
.mod-arr { color: var(--text-dim); font-size: 34rpx; }

.mod-foot {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(27, 34, 44, 0.8);
  flex-wrap: wrap;
}
.mchip {
  font-size: 19rpx;
  color: var(--text-sub);
  border: 1rpx solid var(--lineh, #2a3442);
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
}
.mchip.g { color: var(--gold); border-color: rgba(212, 169, 78, 0.3); }
.mchip.up { color: var(--up); border-color: rgba(240, 75, 90, 0.3); }
.mchip.dn { color: var(--down); border-color: rgba(0, 181, 120, 0.3); }

.pt-tip {
  padding: 10rpx 32rpx;
  font-size: 20rpx;
  color: var(--text-dim);
  text-align: center;
  line-height: 1.6;
}
.pt-footer {
  padding: 20rpx 40rpx 30rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--text-dim);
  line-height: 1.8;
}
.pt-feedback {
  margin-top: 20rpx;
  width: 220rpx;
  height: 56rpx;
  line-height: 54rpx;
  font-size: 22rpx;
  color: var(--text-dim) !important;
  border-color: var(--border) !important;
  border-radius: 28rpx;
  padding: 0;
}
.pt-err { color: var(--up); font-size: 21rpx; margin-top: 10rpx; }
.pt-retry {
  margin: 20rpx auto 0;
  width: 180rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border: 1rpx solid var(--border);
  border-radius: 32rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}

.pt-skeleton { padding: 10rpx 24rpx; }
.pt-sk { height: 180rpx; margin-bottom: 20rpx; }
