<!--gold.wxml 黄金观察模块：实时金价 + 分时/1年/3年走势（滑动查看）+ ETF 配置估算-->
<view class="page">

  <!-- 模块归属条 -->
  <view class="module-tag gold-tag">
    <view class="mt-ic"><ui-icon name="gold" size="26" /></view>
    <text class="mt-name gold-name">拾金观察</text>
    <text class="mt-cur">工作台</text>
  </view>

  <!-- 今日金价（30秒自动刷新） -->
  <view class="card" wx:if="{{spot}}">
    <view class="card-title"><text>今日金价</text><text class="sub">30秒自动刷新 · 更新于 {{spot.shanghai.time}}</text></view>
    <view class="gs-list">
      <view class="gs-row" wx:for="{{spotRows}}" wx:key="code">
        <view class="gs-left">
          <text class="gs-name">{{item.name}}</text>
          <text class="gs-range num" wx:if="{{item.rangeText}}">{{item.rangeText}}</text>
        </view>
        <view class="gs-right">
          <text class="gs-price num">{{item.valText}}</text>
          <text class="gs-unit">{{item.unit}}</text>
          <text class="gs-chg num {{item.chgCls}}">{{item.chgText}}</text>
        </view>
        <view class="gs-fav {{item.isFav ? 'on' : ''}}" catchtap="toggleSpotFav"
              data-code="{{item.code}}" data-name="{{item.name}}">{{item.isFav ? '★' : '☆'}}</view>
      </view>
    </view>
    <view class="gs-premium" wx:if="{{spot.premium !== undefined}}">沪伦溢价 {{spot.premium >= 0 ? '+' : ''}}{{spot.premium}}%<text class="gs-premium-note">（上海金相对伦敦金到岸价，反映国内实物需求）</text></view>
  </view>
  <view wx:if="{{loading && !spot}}" class="loading-box">加载中…</view>

  <!-- 金价走势：分时/近1年/近3年 可切换，支持滑动查看（canvas 常驻不卸载，杜绝挂载竞态） -->
  <view class="card" wx:if="{{goldMode === 'minute' ? !!minute : !!chart}}">
    <view class="card-title">
      <text>金价走势</text>
      <view class="g-tabs">
        <view class="g-tab {{goldMode === 'minute' ? 'on' : ''}}" data-mode="minute" bindtap="onGoldModeTap">分时</view>
        <view class="g-tab {{goldMode === '1y' ? 'on' : ''}}" data-mode="1y" bindtap="onGoldModeTap">近1年</view>
        <view class="g-tab {{goldMode === '3y' ? 'on' : ''}}" data-mode="3y" bindtap="onGoldModeTap">近3年</view>
      </view>
    </view>
    <view class="price-press-bar" wx:if="{{press}}">
      <text class="pp-time num">{{press.time}}</text>
      <text class="pp-price num">{{press.price}}</text>
      <text class="pp-unit">元/克</text>
    </view>
    <view class="cv-wrap" hidden="{{chartLoading}}">
      <canvas type="2d" id="goldCanvas" class="gd-cv"
              catchtouchstart="onGoldTouch" catchtouchmove="onGoldTouch"
              catchtouchend="onGoldTouchEnd" catchtouchcancel="onGoldTouchEnd"></canvas>
    </view>
    <view wx:if="{{chartLoading}}" class="loading-box" style="padding: 20rpx 0 30rpx;">加载中…</view>
    <view class="price-note" wx:if="{{press}}">松开手指返回实时视图</view>
    <view class="price-note" wx:elif="{{goldMode === 'minute' && minute}}">按住曲线滑动查看分钟数据 · {{minute.date}}（交易日：前夜21:00 起至今日 15:00，今晚夜盘待开）</view>
    <view class="price-note" wx:elif="{{goldMode !== 'minute' && chart}}">按住曲线滑动查看历史点位 · {{goldMode === '3y' ? '近3年' : '近1年'}} · {{chart.source === 'futures' ? '沪金期货主力' : '上海金现货'}}</view>
  </view>

  <!-- 股金月度对比 -->
  <view class="card" wx:if="{{monthly}}">
    <view class="card-title"><text>股金月度对比</text><text class="sub">每月涨跌 · 看清对冲属性</text></view>
    <view class="vm-head">
      <text class="vm-h">月份</text>
      <text class="vm-h">沪深300</text>
      <text class="vm-h">黄金</text>
    </view>
    <view class="vm-row" wx:for="{{monthly}}" wx:key="ym">
      <text class="vm-ym num">{{item.ym}}</text>
      <text class="vm-val num {{item.hs300Cls}}">{{item.hs300Text}}</text>
      <text class="vm-val num {{item.goldCls}}">{{item.goldText}}</text>
    </view>
    <view class="vs-note" wx:if="{{vsSummary}}">{{vsSummary}}。配置黄金的意义是平滑组合波动，而非博取短期收益。</view>
  </view>

  <!-- 场内黄金ETF + 配置估算 -->
  <view class="card" wx:if="{{etfs}}">
    <view class="card-title"><text>场内黄金ETF</text><text class="sub">点星标加入我的关注</text></view>
    <view class="ge-row" wx:for="{{etfs}}" wx:key="code"
          data-code="{{item.code}}" data-name="{{item.name}}" bindtap="goStock" hover-class="press">
      <view class="ge-left">
        <text class="ge-name">{{item.name}}</text>
        <text class="ge-code num">{{item.code}}</text>
      </view>
      <text class="ge-price num">{{item.price === null ? '--' : item.price}}</text>
      <text class="ge-chg num {{item.changePercent >= 0 ? 'up' : 'down'}}">{{item.changePercent === null ? '--' : (item.changePercent > 0 ? '+' : '') + item.changePercent + '%'}}</text>
      <view class="ge-fav {{item.isFav ? 'on' : ''}}" catchtap="toggleFav"
            data-code="{{item.code}}" data-name="{{item.name}}" data-market="SH">{{item.isFav ? '★' : '☆'}}</view>
    </view>
    <!-- 配置估算 -->
    <view class="gc-calc">
      <view class="gc-calc-title">配置估算</view>
      <view class="gc-calc-in">
        <input class="gc-in num" type="number" placeholder="输入可投资金额(元)" placeholder-class="tc-ph"
               value="{{amount}}" bindinput="onAmountInput" />
        <view class="gc-btn" bindtap="onCalc">估算</view>
      </view>
      <view class="gc-calc-out" wx:if="{{calc}}">
        <view class="gc-row" wx:for="{{calc}}" wx:key="pct">
          <text class="gc-pct num">{{item.pct}}%</text>
          <text class="gc-amt num">{{item.amountText}} 元</text>
          <text class="gc-shares num">约 {{item.shares}} 份 518880</text>
        </view>
        <view class="gc-note">份额按 518880 最新价估算，场内交易以100份为最小单位；仅为比例换算，非投资建议</view>
      </view>
    </view>
  </view>

  <view class="footer-tip">
    <view>黄金行情仅供参考，不构成投资建议；金价波动较大，配置比例应与自身风险承受能力匹配</view>
  </view>

  <module-switcher current="gold" />
</view>
