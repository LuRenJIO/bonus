/* 红利筛选页 */
.page { min-height: 100vh; padding-bottom: 40rpx; }
.retry-btn {
  margin-top: 30rpx;
  background: var(--gold-bg);
  color: var(--gold);
  font-size: 26rpx;
  padding: 0 50rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
}
.gold-text { color: var(--gold); }
.footer-tip {
  padding: 16rpx 40rpx 40rpx;
  font-size: 20rpx;
  color: var(--text-dim);
  line-height: 1.8;
  text-align: center;
}

/* 利差卡 */
.spread-card { background: linear-gradient(160deg, rgba(76, 141, 255, 0.08), var(--card) 55%); }
.spread-main { text-align: center; padding: 4rpx 0 20rpx; }
.spread-val { font-size: 64rpx; font-weight: 700; }
.spread-comment { font-size: 22rpx; color: var(--text-sub); margin-top: 8rpx; }
.spread-grid { display: flex; border-top: 1rpx solid var(--border); padding-top: 20rpx; }
.sp-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.sp-val { font-size: 30rpx; font-weight: 700; }
.sp-label { font-size: 20rpx; color: var(--text-dim); margin-top: 6rpx; }
.spread-note { font-size: 20rpx; color: var(--text-dim); margin-top: 16rpx; text-align: center; }

/* 筛选chips */
.filter-chips { display: flex; gap: 14rpx; flex-wrap: wrap; }
.chip {
  font-size: 24rpx;
  padding: 10rpx 26rpx;
  border-radius: 26rpx;
  color: var(--text-sub);
  background: rgba(148, 163, 184, 0.10);
}
.chip.on {
  color: #e8b95f;
  background: rgba(212, 169, 78, 0.16);
  font-weight: 600;
}
.board-search {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  gap: 14rpx;
}
.board-in {
  flex: 1;
  background: var(--bg);
  border-radius: 10rpx;
  height: 68rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
}
.board-ph { color: var(--text-dim); }
.board-go {
  font-size: 24rpx;
  color: #1a1d24;
  background: var(--gold);
  padding: 12rpx 28rpx;
  border-radius: 10rpx;
  font-weight: 600;
}
.board-clear { color: var(--text-dim); font-size: 26rpx; padding: 8rpx; }

/* 排行列表 */
.scr-head {
  display: flex;
  font-size: 20rpx;
  color: var(--text-dim);
  padding: 4rpx 0 12rpx;
  border-bottom: 1rpx solid var(--border);
}
.sc-name { flex: 1.3; }
.sc-yld { width: 130rpx; text-align: right; }
.sc-meta { width: 200rpx; text-align: right; }
.scr-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(148, 163, 184, 0.1);
}
.scr-row:last-of-type { border-bottom: none; }
.sc-left { flex: 1.3; min-width: 0; }
.sc-name-line { display: flex; align-items: baseline; }
.sc-stock { font-size: 27rpx; font-weight: 600; margin-right: 10rpx; }
.sc-code { font-size: 20rpx; color: var(--text-dim); }
.sc-board { font-size: 20rpx; color: var(--text-dim); margin-top: 4rpx; }
.sc-yld-val {
  width: 130rpx;
  text-align: right;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--gold);
}
.sc-meta-val { width: 200rpx; text-align: right; font-size: 24rpx; }
.sc-sub { font-size: 18rpx; color: var(--text-dim); margin-top: 4rpx; }
