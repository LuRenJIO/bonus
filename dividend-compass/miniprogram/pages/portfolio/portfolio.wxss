/* 收息记账 */
.page { min-height: 100vh; padding-bottom: 60rpx; }
.gold-text { color: var(--gold); }
.retry-btn {
  margin-top: 30rpx;
  background: var(--gold-bg);
  color: var(--gold);
  font-size: 26rpx;
  padding: 0 50rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
}
.err-detail { font-size: 20rpx; color: var(--text-dim); margin-top: 10rpx; }

/* 空状态引导 */
.pf-hero { text-align: center; padding: 70rpx 40rpx; }
.pf-hero-title { font-size: 36rpx; font-weight: 700; color: var(--gold); }
.pf-hero-sub { font-size: 24rpx; color: var(--text-sub); margin-top: 16rpx; line-height: 1.6; }
.pf-hero-btn {
  margin: 44rpx auto 0;
  width: 320rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: var(--gold);
  color: #1a1d24;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
}

/* 汇总卡 */
.pf-sum { background: linear-gradient(160deg, rgba(212, 169, 78, 0.10), var(--card) 55%); }
.pf-sum-main { text-align: center; padding: 10rpx 0 24rpx; }
.pf-sum-label { font-size: 22rpx; color: var(--text-sub); }
.pf-sum-num { font-size: 64rpx; font-weight: 700; color: var(--gold); margin-top: 8rpx; }
.pf-unit { font-size: 24rpx; font-weight: 400; margin-left: 8rpx; }
.pf-sum-sub { font-size: 20rpx; color: var(--text-dim); margin-top: 8rpx; }
.pf-sum-grid { display: flex; border-top: 1rpx solid var(--border); padding-top: 20rpx; }
.ps-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.ps-val { font-size: 30rpx; font-weight: 700; }
.ps-label { font-size: 20rpx; color: var(--text-dim); margin-top: 6rpx; }

/* 现金流月历 */
.cf-chart {
  display: flex;
  align-items: flex-end;
  height: 200rpx;
  gap: 4rpx;
}
.cf-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
}
.cf-val { font-size: 15rpx; color: var(--text-sub); margin-bottom: 4rpx; }
.cf-stack {
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  width: 70%;
}
.cf-bar-conf {
  background: linear-gradient(180deg, #d4a94e, rgba(212, 169, 78, 0.4));
  border-radius: 4rpx 4rpx 0 0;
}
.cf-bar-est {
  background: rgba(212, 169, 78, 0.22);
  border: 1rpx dashed rgba(212, 169, 78, 0.45);
  border-bottom: none;
  border-radius: 4rpx 4rpx 0 0;
}
.cf-label { font-size: 17rpx; color: var(--text-dim); margin-top: 8rpx; }
.cf-legend { display: flex; gap: 30rpx; margin-top: 16rpx; }
.cf-lg { display: flex; align-items: center; font-size: 20rpx; color: var(--text-dim); }
.cf-dot { width: 14rpx; height: 14rpx; border-radius: 4rpx; margin-right: 8rpx; }
.cf-dot.conf { background: #d4a94e; }
.cf-dot.est { background: rgba(212, 169, 78, 0.25); border: 1rpx dashed rgba(212, 169, 78, 0.5); }
.cf-pending { margin-top: 20rpx; padding-top: 16rpx; border-top: 1rpx solid var(--border); }
.cf-pending-title { font-size: 23rpx; font-weight: 600; color: #e8b95f; }
.cf-pending-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0 0;
  font-size: 21rpx;
}
.cfp-name { color: var(--text-main); }
.cfp-plan { flex: 1; color: var(--text-dim); margin: 0 16rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.cfp-amt { color: var(--gold); font-weight: 600; }
.cf-note { font-size: 19rpx; color: var(--text-dim); margin-top: 14rpx; line-height: 1.6; }

/* 除息倒计时角标 */
.pf-nextex {
  font-size: 18rpx;
  color: #e8b95f;
  background: rgba(212, 169, 78, 0.14);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-left: 10rpx;
  font-weight: 600;
}

/* 标题按钮组 */
.pf-title-btns { display: flex; gap: 24rpx; }
.pf-link { font-size: 24rpx; color: #e8b95f; }

/* 持仓行 */
.pf-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(148, 163, 184, 0.1);
}
.pf-row:last-of-type { border-bottom: none; }
.pf-left { flex: 1.2; min-width: 0; }
.pf-name { font-size: 27rpx; font-weight: 600; }
.pf-meta { font-size: 20rpx; color: var(--text-dim); margin-top: 6rpx; }
.pf-mid { flex: 0.8; text-align: right; margin-right: 20rpx; }
.pf-price { font-size: 26rpx; }
.pf-yld { font-size: 20rpx; color: var(--text-dim); margin-top: 4rpx; }
.pf-right { flex: 0.9; text-align: right; }
.pf-div { font-size: 26rpx; font-weight: 700; color: var(--gold); }
.pf-div-label { font-size: 18rpx; color: var(--text-dim); margin-top: 4rpx; }
.pf-del {
  padding: 10rpx 0 10rpx 24rpx;
  margin-left: 8rpx;
  color: var(--text-dim);
  font-size: 26rpx;
}
.pf-note { font-size: 20rpx; color: var(--text-dim); line-height: 1.6; margin-top: 16rpx; }

/* 添加表单（底部浮层） */
.pf-form-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 10;
}
.pf-form {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  margin: 0;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 11;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
.pf-search-in {
  background: var(--bg);
  border-radius: 10rpx;
  height: 72rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
}
.pf-ph { color: var(--text-dim); }
.pf-search-tip { font-size: 22rpx; color: var(--text-dim); padding: 16rpx 0; text-align: center; }
.pf-sug { max-height: 300rpx; overflow-y: auto; margin-top: 12rpx; }
.pf-sug-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 12rpx;
  font-size: 26rpx;
  border-bottom: 1rpx solid rgba(148, 163, 184, 0.08);
}
.pf-sug-code { color: var(--text-dim); font-size: 22rpx; }
.pf-picked { font-size: 24rpx; color: var(--gold); margin-top: 16rpx; }
.pf-inputs { display: flex; gap: 20rpx; margin-top: 20rpx; }
.pf-field { flex: 1; background: var(--bg); border-radius: 10rpx; padding: 14rpx 18rpx; }
.pf-field-label { font-size: 20rpx; color: var(--text-dim); }
.pf-field-in { height: 48rpx; line-height: 48rpx; font-size: 28rpx; margin-top: 6rpx; }
.pf-save {
  margin-top: 24rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: var(--gold);
  color: #1a1d24;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
}
