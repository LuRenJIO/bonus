<!--index.wxml 首页：搜索 / 自选 / 最近浏览-->
<view class="page">

  <!-- 搜索框 -->
  <view class="search-bar">
    <view class="search-icon">🔍</view>
    <input
      class="search-input"
      placeholder="股票名称 / 拼音首字母 / 6位代码"
      placeholder-class="search-ph"
      value="{{keyword}}"
      confirm-type="search"
      bindinput="onSearchInput"
    />
    <view wx:if="{{keyword}}" class="search-clear" bindtap="onClearSearch">✕</view>
  </view>

  <!-- 搜索建议 -->
  <block wx:if="{{keyword}}">
    <view wx:if="{{searching}}" class="loading-box">搜索中…</view>
    <view wx:elif="{{suggestions.length}}" class="card sug-card">
      <view
        class="sug-item"
        wx:for="{{suggestions}}"
        wx:key="code"
        data-code="{{item.code}}"
        data-name="{{item.name}}"
        data-market="{{item.market}}"
        bindtap="goStock"
      >
        <view class="sug-left">
          <text class="sug-name">{{item.name}}</text>
          <text class="tag">{{item.marketName}}</text>
        </view>
        <view class="sug-code num">{{item.code}}</view>
      </view>
    </view>
    <view wx:elif="{{searched}}" class="empty-box">未找到相关A股</view>
  </block>

  <!-- 默认视图：自选 + 最近浏览 -->
  <block wx:else>
    <!-- 红利速览：大盘/红利指数 + 今日/7日除息动态 -->
    <view class="brief-card card" wx:if="{{briefItems.length}}">
      <view
        class="brief-item {{item.tap ? 'brief-tap' : ''}}"
        wx:for="{{briefItems}}"
        wx:key="label"
        bindtap="{{item.tap ? 'onExTodayTap' : ''}}"
      >
        <text class="brief-label">{{item.label}}</text>
        <text class="brief-val num {{item.cls}}">{{item.val}}</text>
      </view>
    </view>

    <!-- 股息率提醒横幅（红点降级方案：无推送也可见） -->
    <view class="alert-banner" wx:if="{{alertHits.length}}" bindtap="goAlertStock">
      <text class="ab-text">🔔 {{alertHits.length}}只自选触及提醒线：{{alertHitsText}}</text>
    </view>

    <!-- 今日除息弹层（与分红日历差异化：只看今天，快速直达） -->
    <view class="ex-mask" wx:if="{{exSheetOpen}}" bindtap="onExSheetClose"></view>
    <view class="ex-sheet card" wx:if="{{exSheetOpen}}">
      <view class="card-title">
        <text>今日除息 · {{exTodayList.length}} 只</text>
        <text class="sub" wx:if="{{exTodayCash !== null}}">共派现 {{exTodayCash}} 亿</text>
      </view>
      <scroll-view scroll-y class="ex-list">
        <view class="ex-row" wx:for="{{exTodayList}}" wx:key="code"
              data-code="{{item.code}}" data-name="{{item.name}}" bindtap="onExPickStock">
          <text class="ex-name">{{item.name}}</text>
          <text class="ex-code num">{{item.code}}</text>
          <text class="ex-per num">每股{{item.perShare}}元</text>
        </view>
      </scroll-view>
      <view class="ex-close" bindtap="onExSheetClose">收起</view>
    </view>

    <!-- 快捷入口 -->
    <view class="quick-card card">
      <view class="q-item" bindtap="goCalendar">
        <text class="q-icon">📅</text>
        <view class="q-text">
          <view class="q-title">分红日历</view>
          <view class="q-sub">除息日程 · 分红预案</view>
        </view>
      </view>
      <view class="q-divider"></view>
      <view class="q-item" bindtap="goPortfolio">
        <text class="q-icon">💰</text>
        <view class="q-text">
          <view class="q-title">收息记账</view>
          <view class="q-sub">持仓分红 · 今年已收</view>
        </view>
      </view>
    </view>

    <!-- 自选股 -->
    <view class="card">
      <view class="card-title">
        <text>自选股</text>
        <text class="sub">{{favList.length ? favList.length + ' 只' : ''}}</text>
      </view>

      <view wx:if="{{favLoading}}" class="loading-box">加载中…</view>

      <view wx:elif="{{favError}}" class="empty-box">
        <view>云端自选暂不可用</view>
        <view class="err-detail">{{favError}}</view>
        <view class="err-tip">请确认已部署 favorites 云函数并开通云开发</view>
      </view>

      <view wx:elif="{{!favList.length}}" class="empty-box">
        暂无自选股，搜索股票后可在详情页添加
      </view>

      <block wx:else>
        <view
          class="fav-item"
          wx:for="{{favList}}"
          wx:key="code"
          data-code="{{item.code}}"
          data-name="{{item.name}}"
          data-market="{{item.market}}"
          bindtap="goStock"
        >
          <view class="fav-left">
            <view class="fav-name">{{item.name}}</view>
            <view class="fav-code num">{{item.market}} {{item.code}}</view>
          </view>
          <view class="fav-right">
            <view class="fav-price num">{{item.price || '--'}}</view>
            <view class="fav-chg num {{item.changePercent > 0 ? 'up' : item.changePercent < 0 ? 'down' : 'flat'}}">
              {{item.changePercent == null ? '--' : (item.changePercent > 0 ? '+' : '') + item.changePercent + '%'}}
            </view>
          </view>
          <view class="fav-del" data-code="{{item.code}}" catchtap="onRemoveFavorite">✕</view>
        </view>
      </block>
    </view>

    <!-- 最近浏览 -->
    <view class="card" wx:if="{{recent.length}}">
      <view class="card-title"><text>最近浏览</text></view>
      <view class="recent-grid">
        <view
          class="recent-chip"
          wx:for="{{recent}}"
          wx:key="code"
          data-code="{{item.code}}"
          data-name="{{item.name}}"
          data-market="{{item.market}}"
          bindtap="goStock"
        >
          {{item.name}}
        </view>
      </view>
    </view>

    <!-- 说明 -->
    <view class="footer-tip">
      <view>口径说明：TTM股息率 = 近12个月已实施税前分红 ÷ 最新股价</view>
      <view>数据来源：东方财富 · 腾讯财经 ｜ 仅供研究参考，不构成投资建议</view>
    </view>
  </block>
</view>
