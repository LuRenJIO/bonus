/* components/module-switcher/module-switcher.wxss */
.ms-fab {
  position: fixed;
  right: 28rpx;
  bottom: 44rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #f0d08a, #d4a94e);
  color: #1a1d24;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 28rpx rgba(212, 169, 78, 0.45);
  z-index: 998;
}
.ms-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.62);
  z-index: 999;
}
.ms-sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #0c0f14;
  border-top: 1rpx solid var(--lineh, #2a3442);
  border-radius: 32rpx 32rpx 0 0;
  padding: 26rpx 26rpx calc(26rpx + env(safe-area-inset-bottom));
  z-index: 1000;
}
.ms-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.ms-hint { font-size: 20rpx; color: var(--text-dim); font-weight: 400; }
.ms-mod {
  display: flex;
  align-items: center;
  gap: 20rpx;
  border: 1rpx solid var(--border, #232a35);
  border-radius: var(--radius-md, 12rpx);
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
  background: linear-gradient(135deg, #12161d, #0c0f14);
  transition: transform 0.12s ease, border-color 0.12s ease;
}
.ms-mod.cur {
  border-color: rgba(212, 169, 78, 0.5);
  background: linear-gradient(135deg, #221b0e, #12100a);
}
.ms-mod-ic {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(212, 169, 78, 0.35);
  background: rgba(212, 169, 78, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.ms-mod-info { flex: 1; }
.ms-mod-name { font-size: 27rpx; font-weight: 600; }
.ms-mod-desc { font-size: 20rpx; color: var(--text-dim); margin-top: 4rpx; }
.ms-cur {
  font-size: 19rpx;
  color: var(--gold-hi);
  border: 1rpx solid rgba(212, 169, 78, 0.4);
  border-radius: 6rpx;
  padding: 3rpx 10rpx;
}
.ms-go { font-size: 21rpx; color: var(--text-sub); }
.ms-soon {
  display: flex;
  align-items: center;
  gap: 18rpx;
  border: 1rpx dashed var(--border);
  border-radius: var(--radius-md, 12rpx);
  padding: 18rpx 24rpx;
  opacity: 0.55;
  font-size: 22rpx;
  color: var(--text-sub);
}
.ms-soon-ic { display: flex; align-items: center; }
