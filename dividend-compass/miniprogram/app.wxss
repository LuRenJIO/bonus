/**app.wxss —— 全局样式：券商专业风（深色底 / 红涨绿跌 / 高数据密度）
 * v2 深色金融质感升级：金渐变体系 / 卡片两级 / 字号阶梯 / 按压反馈 / 骨架屏
 * 动效仅 transform/opacity（GPU 合成），零图片零字体资源
 */

page {
  --bg: #0e1116;            /* 页面背景 */
  --bg-deep: #090b0f;       /* 更深背景 */
  --card: #161b22;          /* 卡片背景 */
  --card-hover: #1c232d;
  --border: #232a35;        /* 分割线 */
  --text: #e6edf3;          /* 主文字 */
  --text-sub: #8b949e;      /* 次要文字 */
  --text-dim: #59626d;      /* 弱化文字 */
  --up: #f04b5a;            /* 涨（红） */
  --up-bg: rgba(240, 75, 90, 0.12);
  --down: #00b578;          /* 跌（绿） */
  --down-bg: rgba(0, 181, 120, 0.12);
  --gold: #d4a94e;          /* 红利金 */
  --gold-bg: rgba(212, 169, 78, 0.12);
  --blue: #4c8dff;

  /* —— v2 金色体系 —— */
  --gold-hi: #f0d08a;       /* 亮金（数字/图标高光） */
  --gold-deep: #9a7420;     /* 深金 */
  --gold-grad: linear-gradient(135deg, #f0d08a, #d4a94e);
  --gold-glow: 0 0 18rpx rgba(212, 169, 78, 0.25);
  --card-grad: linear-gradient(180deg, #1a2029, #161b22);

  /* —— v2 圆角节奏 —— */
  --radius-lg: 20rpx;
  --radius-md: 12rpx;

  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

/* ---------- 通用卡片（v2：渐变底 + 描边 + 柔和投影） ---------- */
.card {
  background: var(--card-grad);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-lg, 20rpx);
  padding: 24rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.35);
}

/* 强调卡：金色左竖条（体检/汇总/横幅类） */
.card-accent {
  position: relative;
  overflow: hidden;
}
.card-accent::before {
  content: "";
  position: absolute;
  left: 0;
  top: 16rpx;
  bottom: 16rpx;
  width: 6rpx;
  border-radius: 0 6rpx 6rpx 0;
  background: var(--gold-grad);
}

.card-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

/* 标题金色锚点竖条（所有 card-title 自动获得） */
.card-title > text:first-child {
  position: relative;
  padding-left: 20rpx;
}
.card-title > text:first-child::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 26rpx;
  border-radius: 3rpx;
  background: var(--gold-grad);
}

.card-title .sub {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-sub);
}

/* ---------- 涨跌色 ---------- */
.up { color: var(--up); }
.down { color: var(--down); }
.flat { color: var(--text-sub); }

/* ---------- 数字等宽 ---------- */
.num {
  font-family: 'DIN Alternate', 'Menlo', monospace;
  font-variant-numeric: tabular-nums;
}

/* ---------- v2 字号阶梯（金融大数字） ---------- */
.t-hero {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
}
.t-big {
  font-size: 36rpx;
  font-weight: 700;
}
.num-strong {
  font-family: 'DIN Alternate', 'Menlo', monospace;
  font-variant-numeric: tabular-nums;
  font-size: 32rpx;
  font-weight: 700;
}
.gold-glow {
  color: var(--gold-hi);
  text-shadow: var(--gold-glow);
}

/* ---------- v2 按压反馈（配合 hover-class="press"） ---------- */
.press {
  transform: scale(0.985);
  background: var(--card-hover);
  opacity: 0.92;
}
.press-in {
  transform: scale(0.97);
  opacity: 0.88;
}
view.hover-enable, .fav-item, .pf-row, .sug-item, .ge-row, .rp-row, .cal-row, .scr-row, .q-item, .recent-chip {
  transition: transform 0.12s ease, background-color 0.12s ease, opacity 0.12s ease;
}

/* ---------- v2 骨架屏（shimmer） ---------- */
.skeleton {
  position: relative;
  overflow: hidden;
  background: var(--card-hover);
  border-radius: var(--radius-md, 12rpx);
}
.skeleton::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent, rgba(230, 237, 243, 0.06), transparent);
  animation: sk-shimmer 1.4s ease-in-out infinite;
}
@keyframes sk-shimmer {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

/* ---------- v2 金渐变主按钮 ---------- */
.btn-gold {
  background: var(--gold-grad);
  color: #1a1d24;
  font-weight: 600;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 18rpx rgba(212, 169, 78, 0.3);
}

/* ---------- 标签 ---------- */
.tag {
  display: inline-block;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  background: var(--card-hover);
  color: var(--text-sub);
  margin-left: 12rpx;
  vertical-align: middle;
}
.tag-gold { background: var(--gold-bg); color: var(--gold); }
.tag-blue { background: rgba(76, 141, 255, 0.14); color: var(--blue); }

/* ---------- 状态灯 ---------- */
.dot {
  display: inline-block;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.dot-good { background: #00b578; box-shadow: 0 0 8rpx rgba(0, 181, 120, 0.6); }
.dot-warn { background: #d4a94e; box-shadow: 0 0 8rpx rgba(212, 169, 78, 0.6); }
.dot-bad { background: #f04b5a; box-shadow: 0 0 8rpx rgba(240, 75, 90, 0.6); }

/* ---------- 表格 ---------- */
.table { width: 100%; }
.table-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border);
  font-size: 24rpx;
}
.table-row:last-child { border-bottom: none; }
.table-head {
  color: var(--text-dim);
  font-size: 22rpx;
}

/* ---------- 加载与空状态 ---------- */
.loading-box {
  padding: 60rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: var(--text-sub);
  font-size: 24rpx;
}
.empty-box {
  padding: 80rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: var(--text-dim);
  font-size: 24rpx;
}

button {
  background: var(--card-hover);
  color: var(--text);
}
button::after { border: none; }
